<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== SUPERFÍCIES (fundos) ===== -->
    <Color x:Key="Surface">#FEF7EE</Color>
    <Color x:Key="SurfaceAlt">#F2D8BC</Color>
    <Color x:Key="SurfaceRaised">#FFFAF3</Color>
    <Color x:Key="SurfaceOverlay">#E6FEF7EE</Color>

    <!-- ===== TEXTO ===== -->
    <Color x:Key="TextPrimary">#2B1F18</Color>
    <Color x:Key="TextSecondary">#6B5646</Color>
    <Color x:Key="TextMuted">#8F7B62</Color>
    <Color x:Key="TextDisabled">#CDB89A</Color>
    <Color x:Key="TextOnAccent">#FFFFFF</Color>

    <!-- ===== ACCENT PRIMÁRIO (Torii ao amanhecer) ===== -->
    <Color x:Key="Accent">#E0561F</Color>
    <Color x:Key="AccentLight">#EE7A45</Color>
    <Color x:Key="AccentDark">#B8421A</Color>
    <Color x:Key="AccentSoft">#F8DBC6</Color>
    <Color x:Key="AccentTertiary">#5F94A8</Color>

    <!-- ===== ACCENT SECUNDÁRIO ===== -->
    <Color x:Key="AccentAlt">#D9A21F</Color>
    <Color x:Key="AccentAltLight">#E6B93F</Color>

    <!-- ===== BOTÕES ===== -->
    <Color x:Key="ButtonSurface">#FFFFFF</Color>
    <Color x:Key="ButtonSurfaceHover">#F2D8BC</Color>
    <Color x:Key="ButtonSurfacePressed">#EBD2B3</Color>
    <Color x:Key="ButtonIcon">#6B5646</Color>
    <Color x:Key="ButtonIconHover">#E0561F</Color>

    <!-- ===== LISTA ===== -->

    <Color x:Key="ListHover">#F2D8BC</Color>
    <Color x:Key="ListSelected">#F8DBC6</Color>
    <Color x:Key="ListSelectedBorder">#E0561F</Color>

    <!-- ===== BORDAS ===== -->
    <Color x:Key="Border">#E3C9A6</Color>
    <Color x:Key="Divider">#EBD3B5</Color>
    <Color x:Key="BorderStrong">#DCC19C</Color>

    <!-- ===== ESTADOS FUNCIONAIS ===== -->
    <Color x:Key="Success">#4F8F62</Color>
    <Color x:Key="Warning">#D9A21F</Color>
    <Color x:Key="Error">#E03E2E</Color>

    <!-- ===== PLAYER ===== -->
    <Color x:Key="ProgressFill">#E0561F</Color>

    <Color x:Key="ProgressTrack">#FBEBD8</Color>

    <!-- ===== SOMBRA ===== -->
    <Color x:Key="Shadow">#202B1F18</Color>

    <!-- ===== BRUSHES (versões prontas a usar em Background/Foreground) ===== -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAlt}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaised}" />
    <SolidColorBrush x:Key="SurfaceOverlayBrush" Color="{StaticResource SurfaceOverlay}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLight}" />
    <SolidColorBrush x:Key="AccentAltBrush" Color="{StaticResource AccentAlt}" />
    <SolidColorBrush x:Key="AccentTertiaryBrush" Color="{StaticResource AccentTertiary}" />
    <SolidColorBrush x:Key="AccentAltLightBrush" Color="{StaticResource AccentAltLight}" />
    <SolidColorBrush x:Key="BorderBrush2" Color="{StaticResource Border}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrong}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource Divider}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoft}" />
    <SolidColorBrush x:Key="SurfaceSuccess" Color="{StaticResource Success}" />
    <SolidColorBrush x:Key="SurfaceWarning" Color="{StaticResource Warning}" />
    <SolidColorBrush x:Key="SurfaceError" Color="{StaticResource Error}" />
    <SolidColorBrush x:Key="TextSuccess" Color="{StaticResource Success}" />
    <SolidColorBrush x:Key="TextWarning" Color="{StaticResource Warning}" />
    <SolidColorBrush x:Key="TextError" Color="{StaticResource Error}" />
    <SolidColorBrush x:Key="ProgressFillBrush" Color="{StaticResource ProgressFill}" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="{StaticResource ProgressTrack}" />
    <SolidColorBrush x:Key="ListHoverBrush" Color="{StaticResource ListHover}" />
    <SolidColorBrush x:Key="ListSelectedBrush" Color="{StaticResource ListHover}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabled}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccent}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDark}" />
    <SolidColorBrush x:Key="ButtonSurfaceBrush" Color="{StaticResource ButtonSurface}" />
    <SolidColorBrush x:Key="ButtonSurfaceHoverBrush" Color="{StaticResource ButtonSurfaceHover}" />
    <SolidColorBrush x:Key="ButtonSurfacePressedBrush" Color="{StaticResource ButtonSurfacePressed}" />
    <SolidColorBrush x:Key="ButtonIconBrush" Color="{StaticResource ButtonIcon}" />
    <SolidColorBrush x:Key="ButtonIconHoverBrush" Color="{StaticResource ButtonIconHover}" />
    <SolidColorBrush x:Key="ListSelectedBorderBrush" Color="{StaticResource ListSelectedBorder}" />
    <!-- ===== GRADIENTES ===== -->
    <LinearGradientBrush x:Key="GradientBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Surface}" Offset="0" />
        <GradientStop Color="{StaticResource SurfaceRaised}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientAccent" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource Accent}" Offset="0" />
        <GradientStop Color="{StaticResource AccentAlt}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradientPlayerOverlay" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="{StaticResource Shadow}" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>