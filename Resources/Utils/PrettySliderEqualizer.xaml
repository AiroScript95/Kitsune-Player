<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Project_Kitsune.Converters">

    <!-- Calcula a altura do preenchimento a partir do centro (0 dB) -->
    <conv:GanhoParaAlturaConverter x:Key="GanhoParaAlturaConverter" />

    <!-- Faixa acima do Thumb (só área clicável, já não desenha nada) -->
    <Style x:Key="SliderRepeatButtonVerticalTop" TargetType="RepeatButton">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Faixa abaixo do Thumb (só área clicável, já não desenha nada) -->
    <Style x:Key="SliderRepeatButtonVerticalBottom" TargetType="RepeatButton">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thumb com Opacidade e Altura Zeradas por Padrão -->
    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Width" Value="0" />
        <Setter Property="Height" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="20"
                          Height="20"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Cursor="Hand">
                        <Ellipse Fill="White"
                                 Stroke="{DynamicResource AccentAltBrush}"
                                 StrokeThickness="3" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider vertical com Triggers de Animação -->
    <ControlTemplate x:Key="SliderVertical" TargetType="Slider">
        <Grid Width="40" Background="Transparent">

            <!-- Trilho de fundo -->
            <Border Width="6"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource SurfaceOverlayBrush}"
                    Style="{DynamicResource BorderCircularClip}" />

            <!-- Preenchimento a partir do centro (0 dB) -->
            <Grid Width="12" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Metade de cima: ganho positivo, cresce para cima -->
                <Border Grid.Row="0" VerticalAlignment="Bottom" CornerRadius="6"
                        Background="{DynamicResource AccentAltBrush}">
                    <Border.Height>
                        <MultiBinding Converter="{StaticResource GanhoParaAlturaConverter}" ConverterParameter="cima">
                            <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                            <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                            <Binding Path="ActualHeight" RelativeSource="{RelativeSource TemplatedParent}" />
                        </MultiBinding>
                    </Border.Height>
                </Border>

                <!-- Metade de baixo: ganho negativo, cresce para baixo -->
                <Border Grid.Row="1" VerticalAlignment="Top" CornerRadius="6"
                        Background="{DynamicResource AccentAltBrush}">
                    <Border.Height>
                        <MultiBinding Converter="{StaticResource GanhoParaAlturaConverter}" ConverterParameter="baixo">
                            <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                            <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                            <Binding Path="ActualHeight" RelativeSource="{RelativeSource TemplatedParent}" />
                        </MultiBinding>
                    </Border.Height>
                </Border>
            </Grid>

            <!-- Marca do 0 dB -->
            <Rectangle Height="1" Width="30" HorizontalAlignment="Center"
                       Fill="{DynamicResource TextDisabledBrush}" IsHitTestVisible="False" />

            <!-- Track por último, para o Thumb receber o rato -->
            <Track x:Name="PART_Track" HorizontalAlignment="Center" Width="40">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="Slider.DecreaseLarge"
                                  Style="{StaticResource SliderRepeatButtonVerticalBottom}" />
                </Track.DecreaseRepeatButton>

                <Track.Thumb>
                    <Thumb x:Name="ThumbElement" Style="{StaticResource SliderThumb}" />
                </Track.Thumb>

                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="Slider.IncreaseLarge"
                                  Style="{StaticResource SliderRepeatButtonVerticalTop}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ThumbElement"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="ThumbElement"
                                             Storyboard.TargetProperty="Width"
                                             To="20" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="ThumbElement"
                                             Storyboard.TargetProperty="Height"
                                             To="20" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ThumbElement"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="ThumbElement"
                                             Storyboard.TargetProperty="Width"
                                             To="0" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="ThumbElement"
                                             Storyboard.TargetProperty="Height"
                                             To="0" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Equalizador -->
    <Style x:Key="PrettySliderEqualizer" TargetType="Slider">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Template" Value="{StaticResource Slider}" />
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Template" Value="{StaticResource SliderVertical}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>