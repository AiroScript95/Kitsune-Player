<UserControl x:Class="Project_Kitsune.Views.Controls.PlayerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:Project_Kitsune.Views.Controls"
             DataContext="{Binding PlayerViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid MaxHeight="680" Margin="16,16,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="50*" />
                <RowDefinition Height="12*" />
                <RowDefinition Height="5*" />
                <RowDefinition Height="5*" />
                <RowDefinition Height="15*" />
                <RowDefinition Height="10*" />
            </Grid.RowDefinitions>

            <!-- Capa grande: música que está a tocar agora -->
            <Border Margin="0,0,0,0"
                    MinWidth="350"
                    MinHeight="320"
                    MaxHeight="360"
                    Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    ClipToBounds="True"
                    CornerRadius="16"
                    Style="{StaticResource BorderClip}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top">
                <Grid ClipToBounds="True" x:Name="RootGrid">
                    <Image Source="{Binding MusicaAtual.Image, Converter={StaticResource BytesParaImagemConverter}}"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <iconPacks:PackIconBoxIcons Kind="SolidMusic"
                                                Width="48"
                                                Height="48"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding MusicaAtual.Image, Converter={StaticResource NullToVisibilityConverter}}" />
                    <Button x:Name="OverlayMiniPlayer"
                            HorizontalAlignment="Right" Click="AbrirMiniPlayer_Click"
                            VerticalAlignment="Top" Foreground="{DynamicResource TextOnAccentBrush}" Margin="10">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonSmall}">
                                <Setter Property="Opacity" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=RootGrid}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <iconPacks:PackIconBoxIcons2 Kind="RegularExpandAlt" Width="20" />
                    </Button>
                </Grid>
            </Border>
            <!-- Título / Artista da música atual -->
            <Grid Grid.Row="1">
                <StackPanel>
                    <TextBlock Text="{Binding MusicaAtual.Titulo, FallbackValue='Nenhuma música'}"
                               FontSize="18"
                               MaxWidth="260"
                               HorizontalAlignment="Left"
                               FontWeight="Bold"
                               FontFamily="{StaticResource FonteInter}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               TextAlignment="Left"
                               Margin="0,20,0,4" />
                    <TextBlock Text="{Binding MusicaAtual.Artista}"
                               FontSize="13"
                               MaxWidth="260"
                               HorizontalAlignment="Left"
                               FontFamily="{StaticResource FonteInter}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               TextAlignment="Left"
                               Margin="0,0,0,20" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Command="{Binding AlternarGostoCommand}"
                            CommandParameter="{Binding MusicaAtual}"
                            Style="{StaticResource IconButtonSmall}"
                            Width="36"
                            Height="36"
                            Margin="4,0">
                        <iconPacks:PackIconBoxIcons Width="24"
                                                    Height="18">
                            <iconPacks:PackIconBoxIcons.Style>
                                <Style TargetType="iconPacks:PackIconBoxIcons">
                                    <Setter Property="Kind"
                                            Value="RegularHeart" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GostoAtual}"
                                                     Value="True">
                                            <Setter Property="Kind"
                                                    Value="SolidHeart" />
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource TextError}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconBoxIcons.Style>
                        </iconPacks:PackIconBoxIcons>
                    </Button>
                    <Button Style="{StaticResource IconButtonSmall}">
                        <iconPacks:PackIconBoxIcons Kind="RegularDotsVertical" />
                    </Button>
                </StackPanel>
            </Grid>
            <!-- Barra de progresso + tempos -->
            <Slider Style="{StaticResource PrettySlider}"
                    Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    Minimum="0"
                    Maximum="{Binding DuracaoTotalMs}"
                    Value="{Binding PosicaoAtualMs}"
                    PreviewMouseLeftButtonDown="Slider_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="Slider_PreviewMouseMove"
                    PreviewMouseLeftButtonUp="Slider_PreviewMouseUp"
                    PreviewMouseUp="Slider_PreviewMouseUp"
                    Cursor="Hand" />

            <Grid Margin="0,4,0,10"
                  Grid.Row="3">
                <TextBlock Text="{Binding TempoAtualFormatado, FallbackValue='00:00'}"
                           FontSize="12"
                           FontFamily="{StaticResource FonteJetBrains}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Left" />
                <TextBlock Text="{Binding TempoTotalFormatado, FallbackValue='00:00'}"
                           FontSize="12"
                           FontFamily="{StaticResource FonteJetBrains}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Right" />
            </Grid>

            <!-- Controlos -->
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Grid.Row="4" Margin="0,10">
                <Button Command="{Binding AnteriorCommand}"
                        Style="{StaticResource PlayerControlButton}"
                        Margin="8,0">
                    <Viewbox Width="auto" Height="auto" MaxHeight="40" MaxWidth="35">
                        <iconPacks:PackIconBoxIcons Kind="SolidSkipPrevious" />
                    </Viewbox>
                </Button>

                <Button Command="{Binding AlternarPlayPauseCommand}"
                        Style="{StaticResource PlayerPlayButton}"
                        Margin="0,0">
                    <Viewbox Width="auto" Height="auto" MaxHeight="40" MaxWidth="35">
                        <iconPacks:PackIconBoxIcons>
                            <iconPacks:PackIconBoxIcons.Style>
                                <Style TargetType="iconPacks:PackIconBoxIcons">
                                    <Setter Property="Kind"
                                            Value="SolidPlay" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EstaTocando}"
                                                     Value="True">
                                            <Setter Property="Kind"
                                                    Value="SolidPause" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconBoxIcons.Style>
                        </iconPacks:PackIconBoxIcons>
                    </Viewbox>
                </Button>

                <Button Command="{Binding ProximaCommand}"
                        Style="{StaticResource PlayerControlButton}"
                        Margin="8,0">
                    <Viewbox Width="auto" Height="auto" MaxHeight="40" MaxWidth="35">
                        <iconPacks:PackIconBoxIcons Kind="SolidSkipNext" />
                    </Viewbox>
                </Button>
            </StackPanel>

            <!-- Equalizador / Repetição -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Grid.Row="5"
                        Margin="0,20,0,10">

                <!-- Botão Equalizador -->
                <Button Command="{Binding AlternarEqualizadorCommand}"
                        Style="{StaticResource IconButtonSmall}"
                        Margin="4,0">
                    <iconPacks:PackIconBoxIcons Kind="RegularSliderAlt"
                                                Width="18" Foreground="{DynamicResource TextSecondaryBrush}"
                                                Height="18" />
                </Button>

                <!--Botao Mostrar letra -->
                <Button Command="{Binding AlternarLetrasCommand}"
                        MinWidth="180"
                        Height="30"
                        Margin="10,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderThickness="0"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Style="{StaticResource ButtonPrimary}"
                        hc:BorderElement.CornerRadius="14">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularMessageBubbleDots"
                                                    Width="16"
                                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"
                                                    Visibility="{Binding TemLetra,Converter={StaticResource Boolean2VisibilityReConverter}}" />
                        <TextBlock Text="{Binding LinhaAtual.Texto, FallbackValue={StaticResource Str_Sem_Letra}}"
                                   FontFamily="{StaticResource FonteInter}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="150"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Botão Loop (Todos / Uma) -->
                <Button Command="{Binding AlternarRepeticaoCommand}"
                        Style="{StaticResource IconButtonSmall}"
                        Margin="4,0">
                    <Grid>
                        <iconPacks:PackIconBoxIcons Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                            <iconPacks:PackIconBoxIcons.Style>
                                <Style TargetType="iconPacks:PackIconBoxIcons">
                                    <Setter Property="Kind"
                                            Value="RegularRepeat" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Repeticao}"
                                                     Value="RepetirLista">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Repeticao}"
                                                     Value="RepetirUma">
                                            <Setter Property="Kind"
                                                    Value="SolidRepeat" />
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Repeticao}"
                                                     Value="Aleatorio">
                                            <Setter Property="Kind"
                                                    Value="SolidShuffle" />
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconBoxIcons.Style>
                        </iconPacks:PackIconBoxIcons>
                        <TextBlock Text="1"
                                   FontSize="8"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Repeticao}"
                                                     Value="RepetirUma">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>