<UserControl x:Class="Project_Kitsune.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:converters="clr-namespace:Project_Kitsune.Converters"
             xmlns:vm="clr-namespace:Project_Kitsune.ViewModels.ShellPages"
             xmlns:pages="clr-namespace:Project_Kitsune.Views.ShellPages"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <converters:LinhaAtualConverter x:Key="LinhaAtualConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:BytesParaImagemConverter x:Key="BytesParaImagemConverter" />
        <converters:BytesParaThumbConverter x:Key="BytesParaThumbConverter" />
        <converters:MusicaAtualConverter x:Key="MusicaAtualConverter" />
        <converters:ProgressoParaLarguraConverter x:Key="ProgressoParaLarguraConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:StringParaImagemConverter x:Key="StringParaImagemConverter" />
        <converters:StringToUriConverter x:Key="StringToUriConverter" />

        <DataTemplate DataType="{x:Type vm:MusicListPageViewModel}">
            <pages:MusicListPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfiguracoesPageViewModel}">
            <pages:ConfiguracoesPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfigTemaPageViewModel}">
            <pages:ConfigTemaPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaylistsPageViewModel}">
            <pages:PlaylistsPages />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaylistDetailPageViewModel}">
            <pages:PlaylistDetailPage />
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <!--Conteudo UserControl-->
        <Grid ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  SIDEBAR  -->
            <Grid Margin="0,10">
                <StackPanel VerticalAlignment="Center"  HorizontalAlignment="Center">
                    <Button Command="{Binding IrParaMusicasCommand}"
                            Style="{StaticResource SidebarButton}"
                            ToolTip="{DynamicResource Str_Musicas}">
                        <iconPacks:PackIconBoxIcons Width="20" Height="20">
                            <iconPacks:PackIconBoxIcons.Style>
                                <Style TargetType="iconPacks:PackIconBoxIcons">
                                    <Setter Property="Kind" Value="RegularMusic" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Page}" Value="MusicList">
                                            <Setter Property="Kind" Value="SolidMusic" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconBoxIcons.Style>
                        </iconPacks:PackIconBoxIcons>
                    </Button>
                    <Button Command="{Binding IrParaPlaylistCommand}"
                            Style="{StaticResource SidebarButton}"
                            ToolTip="{DynamicResource Str_Playlists}">
                        <iconPacks:PackIconBoxIcons Width="20" Height="20">
                            <iconPacks:PackIconBoxIcons.Style>
                                <Style TargetType="iconPacks:PackIconBoxIcons">
                                    <Setter Property="Kind" Value="RegularMusicLibrary" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Page}" Value="Playlist">
                                            <Setter Property="Kind" Value="SolidMusicLibrary" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconBoxIcons.Style>
                        </iconPacks:PackIconBoxIcons>
                    </Button>
                    <Button Command="{Binding AbrirFavoritosCommand}"
                            Style="{StaticResource SidebarButton}"
                            ToolTip="{DynamicResource Str_Add_Play}">
                        <iconPacks:PackIconBoxIcons Width="20" Height="20">
                            <iconPacks:PackIconBoxIcons.Style>
                                <Style TargetType="iconPacks:PackIconBoxIcons">
                                    <Setter Property="Kind" Value="RegularHeart" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Page}" Value="Favoritos">
                                            <Setter Property="Kind" Value="SolidHeart" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconBoxIcons.Style>
                        </iconPacks:PackIconBoxIcons>
                    </Button>
                    <Button Style="{StaticResource SidebarButton}"
                            ToolTip="Adicionar play">
                        <iconPacks:PackIconBoxIcons Kind="SolidBlock" Width="20" Height="20" />
                    </Button>
                    <Button Style="{StaticResource SidebarButton}"
                            ToolTip="Adicionar play">
                        <iconPacks:PackIconBoxIcons Kind="SolidBlock" Width="20" Height="20" />
                    </Button>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <Button Command="{Binding IrParaConfiguracoesCommand}"
                            Style="{StaticResource SidebarButton}"
                            ToolTip="{DynamicResource Str_Configuracoes}"
                            VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,0,0,0">
                        <iconPacks:PackIconBoxIcons Width="20" Height="20">
                            <iconPacks:PackIconBoxIcons.Style>
                                <Style TargetType="iconPacks:PackIconBoxIcons">
                                    <Setter Property="Kind" Value="RegularCog" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Page}" Value="Config">
                                            <Setter Property="Kind" Value="SolidCog" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconBoxIcons.Style>
                        </iconPacks:PackIconBoxIcons>
                    </Button>
                </StackPanel>
            </Grid>

            <!--  CONTEÚDO  -->
            <Border Grid.Column="1" CornerRadius="4,0,0,0" Margin="0,2,0,0"  ClipToBounds="True"
                    BorderThickness="1,1,0,0" BorderBrush="{DynamicResource BorderBrush2}"
                    Style="{StaticResource BorderClip}"
                    Background="{DynamicResource GradientBackground}">
                <Grid ClipToBounds="True">
                    <Border Style="{StaticResource BorderClip}" CornerRadius="4,0,0,0">
                        <Grid ClipToBounds="True">
                            <!--<svg:SvgViewbox Source="{Binding Tema,Converter={StaticResource StringToUriConverter}}"
                            Width="100" Height="100" HorizontalAlignment="Right" VerticalAlignment="Bottom" />-->
                            <Image Source="{Binding CaminhoBackground, Converter={StaticResource StringParaImagemConverter}}"
                                   Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Background="{DynamicResource SurfaceOverlayBrush}" Opacity="0.65" ClipToBounds="True" CornerRadius="4,0,0,0" />
                    <Border Style="{StaticResource BorderClip}" ClipToBounds="True" CornerRadius="4,0,0,0">
                        <ContentControl  Content="{Binding CurrentPage}" ClipToBounds="True">
                            <ContentControl.Resources>
                                <Style TargetType="ContentPresenter">
                                    <Style.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="1"
                                                                     Duration="0:0:0.25">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                     From="30" To="0"
                                                                     Duration="0:0:0.25">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Style.Triggers>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform X="0" />
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ContentControl.Resources>
                        </ContentControl>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- LETRAS -->
        <Grid Background="{DynamicResource SurfaceBrush}" Focusable="True">
            <Grid.RenderTransform>
                <TranslateTransform Y="100" />
            </Grid.RenderTransform>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Player.MostrarLetra}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                            From="100" To="0" Duration="0:0:0.10" />
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.10" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                            From="0" To="100" Duration="0:0:0.10" />
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.10" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.20" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Botão fechar -->
            <Grid Grid.Row="0" Height="24">
                <Button Background="{DynamicResource SurfaceBrush}" Width="Auto" Height="40" Cursor="Hand" BorderThickness="0" ToolTip="{DynamicResource Str_Fechar}"
                        Command="{Binding Player.FecharLetraCommand}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Foreground="{DynamicResource TextSecondaryBrush}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Border Width="40" Height="5" Background="{DynamicResource TextMutedBrush}" Style="{StaticResource BorderCircular}" />
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  COLUNA 0: Player  -->
                <Grid Grid.Column="0" Margin="10,0" VerticalAlignment="Center">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Width" Value="400" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Player.OcultarControles}" Value="true">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.10">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="400" Duration="0:0:0.10">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Capa grande -->
                        <Border Grid.Row="0" Height="340" Width="340"
                                Background="{DynamicResource SurfaceBrush}"
                                ClipToBounds="True"
                                CornerRadius="16"
                                Style="{StaticResource BorderClip}"
                                HorizontalAlignment="Center" VerticalAlignment="Top">

                            <Grid ClipToBounds="True" x:Name="RootGrid">
                                <Image Source="{Binding Player.MusicaAtual.Image, Converter={StaticResource BytesParaImagemConverter}}"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <iconPacks:PackIconBoxIcons Kind="SolidMusic"
                                                            Width="48" Height="48"
                                                            Foreground="{DynamicResource TextMutedBrush}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Visibility="{Binding Player.MusicaAtual.Image, Converter={StaticResource NullToVisibilityConverter}}" />
                                <Button x:Name="OverlayMiniPlayer"
                                        HorizontalAlignment="Right" Click="AbrirMiniPlayer_Click"
                                        VerticalAlignment="Top" Foreground="{DynamicResource TextOnAccentBrush}" Margin="10">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonSmall}">
                                            <Setter Property="Opacity" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=RootGrid}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <iconPacks:PackIconBoxIcons2 Kind="RegularExpandAlt" Width="20" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Título / Artista -->
                        <Grid Grid.Row="1">
                            <StackPanel>
                                <TextBlock Text="{Binding Player.MusicaAtual.Titulo, FallbackValue='Nenhuma música'}"
                                           FontSize="18" MaxWidth="260" HorizontalAlignment="Left" FontWeight="Bold"
                                           FontFamily="{StaticResource FonteInter}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" TextAlignment="Left" Margin="0,16,0,4" />
                                <TextBlock Text="{Binding Player.MusicaAtual.Artista}"
                                           FontSize="13" MaxWidth="260" HorizontalAlignment="Left"
                                           FontFamily="{StaticResource FonteInter}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" TextAlignment="Left" Margin="0,0,0,16" />
                            </StackPanel>
                            <Button Command="{Binding Player.AlternarGostoCommand}"
                                    Style="{StaticResource IconButtonSmall}"
                                    Margin="4,0" HorizontalAlignment="Right">
                                <iconPacks:PackIconBoxIcons Width="24" Height="18">
                                    <iconPacks:PackIconBoxIcons.Style>
                                        <Style TargetType="iconPacks:PackIconBoxIcons">
                                            <Setter Property="Kind" Value="RegularHeart" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Player.GostoAtual}" Value="True">
                                                    <Setter Property="Kind" Value="SolidHeart" />
                                                    <Setter Property="Foreground" Value="#E11D48" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </iconPacks:PackIconBoxIcons.Style>
                                </iconPacks:PackIconBoxIcons>
                            </Button>
                        </Grid>

                        <!-- Progresso -->
                        <Slider Grid.Row="2" Style="{StaticResource PrettySlider}" HorizontalAlignment="Stretch"
                                Minimum="0" Maximum="{Binding Player.DuracaoTotalMs}"
                                Value="{Binding Player.PosicaoAtualMs}"
                                PreviewMouseLeftButtonDown="Slider_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="Slider_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="Slider_PreviewMouseUp"
                                PreviewMouseUp="Slider_PreviewMouseUp"
                                Cursor="Hand" />

                        <Grid Grid.Row="3" Margin="0,4,0,16">
                            <TextBlock Text="{Binding Player.TempoAtualFormatado, FallbackValue='0:00'}"
                                       FontSize="12" FontFamily="{StaticResource FonteJetBrains}"
                                       Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding Player.TempoTotalFormatado, FallbackValue='0:00'}"
                                       FontSize="12" FontFamily="{StaticResource FonteJetBrains}"
                                       Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                        </Grid>

                        <!-- Controlos principais -->
                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Command="{Binding Player.AnteriorCommand}" Style="{StaticResource PlayerControlButton}"
                                    Margin="6,0">
                                <iconPacks:PackIconBoxIcons Kind="SolidSkipPrevious" Width="30" Height="30" />
                            </Button>
                            <Button Command="{Binding Player.AlternarPlayPauseCommand}" Style="{StaticResource PlayerPlayButton}" Margin="0,0">
                                <iconPacks:PackIconBoxIcons Width="30" Height="30">
                                    <iconPacks:PackIconBoxIcons.Style>
                                        <Style TargetType="iconPacks:PackIconBoxIcons">
                                            <Setter Property="Kind" Value="SolidPlay" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Player.EstaTocando}" Value="True">
                                                    <Setter Property="Kind" Value="SolidPause" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </iconPacks:PackIconBoxIcons.Style>
                                </iconPacks:PackIconBoxIcons>
                            </Button>
                            <Button Command="{Binding Player.ProximaCommand}" Style="{StaticResource PlayerControlButton}"
                                    Margin="6,0">
                                <iconPacks:PackIconBoxIcons Kind="SolidSkipNext" Width="30" Height="30" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!--  COLUNA 1: Letras  -->
                <Grid Grid.Column="1" Margin="16,20,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,0,0,8">
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Str_Letras}" FontSize="24" Foreground="{DynamicResource TextMutedBrush}"
                                       FontWeight="Bold" FontFamily="{StaticResource FonteHiragino}" />
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                            <Button Command="{Binding Player.AlternarControlesCommand}" ToolTip="{DynamicResource Str_Ocultar_controles}"
                                    BorderThickness="0" Margin="6,0" Width="36" Height="36"
                                    Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}">
                                <iconPacks:PackIconBoxIcons>
                                    <iconPacks:PackIconBoxIcons.Style>
                                        <Style TargetType="iconPacks:PackIconBoxIcons">
                                            <Setter Property="Kind" Value="SolidEye" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.Player.OcultarControles, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="true">
                                                    <Setter Property="Kind" Value="SolidEyeSlash" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </iconPacks:PackIconBoxIcons.Style>
                                </iconPacks:PackIconBoxIcons>
                            </Button>
                            <Button ToolTip="{DynamicResource Str_Rolagem}" BorderThickness="0" Margin="6,0" Width="36" Height="36"
                                    Background="{DynamicResource SurfaceBrush}"
                                    Command="{Binding Player.AlternarScrollAutomaticoCommand}">
                                <iconPacks:PackIconBoxIcons Kind="RegularMoveVertical">
                                    <iconPacks:PackIconBoxIcons.Style>
                                        <Style TargetType="iconPacks:PackIconBoxIcons">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Player.ScrollAutomaticoAtivo}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </iconPacks:PackIconBoxIcons.Style>
                                </iconPacks:PackIconBoxIcons>
                            </Button>
                            <Button ToolTip="{DynamicResource Str_Editar}" BorderThickness="0" Margin="6,0" Width="36" Height="36"
                                    Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}"
                                    Click="EditarLetra_Click">
                                <iconPacks:PackIconBoxIcons Kind="SolidPencil" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding Player.TemLetra, Converter={StaticResource Boolean2VisibilityReConverter}}">

                            <iconPacks:PackIconBoxIcons Kind="SolidPencilDraw" Width="80" Height="80"
                                                        HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />

                            <TextBlock Text="{DynamicResource Str_Sem_Letra}" HorizontalAlignment="Center" Margin="10"
                                       FontFamily="{StaticResource FonteJetBrains}" Foreground="{DynamicResource TextMutedBrush}" />
                            <Button BorderBrush="{DynamicResource SecondaryBorderBrush}" BorderThickness="1"
                                    Background="Transparent" hc:BorderElement.CornerRadius="15" Margin="0,10" Height="Auto"
                                    Click="EditarLetra_Click">
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <iconPacks:PackIconBoxIcons Kind="SolidPlus" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Text="{DynamicResource Str_Add_Letra}" FontFamily="{StaticResource FonteInter}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <ScrollViewer x:Name="ScrollLetras" VerticalScrollBarVisibility="Hidden" Margin="16,0,0,20"
                                      Visibility="{Binding Player.TemLetra, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl x:Name="ItemsLetras" ItemsSource="{Binding Player.LetraAtual.Linhas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Texto}"
                                                   FontFamily="{StaticResource FonteInter}"
                                                   TextWrapping="Wrap" Margin="0,10" Cursor="Hand"
                                                   MouseLeftButtonUp="LinhaLetra_Click" TextAlignment="Left">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Setter Property="Opacity" Value="0.5" />
                                                    <Setter Property="FontSize" Value="22" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.Player.OcultarControles, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                            <Setter Property="FontSize" Value="28" />
                                                        </DataTrigger>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource LinhaAtualConverter}">
                                                                    <Binding />
                                                                    <Binding Path="DataContext.Player.LinhaAtual" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                            <Setter Property="FontSize" Value="26" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <QuadraticEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.5">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <QuadraticEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding DataContext.Player.OcultarControles, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                                <Condition Value="True">
                                                                    <Condition.Binding>
                                                                        <MultiBinding Converter="{StaticResource LinhaAtualConverter}">
                                                                            <Binding />
                                                                            <Binding Path="DataContext.Player.LinhaAtual" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                        </MultiBinding>
                                                                    </Condition.Binding>
                                                                </Condition>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="FontSize" Value="34" />
                                                        </MultiDataTrigger>
                                                        <DataTrigger Binding="{Binding DataContext.Player.LetraAtual.Sincronizada, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                                            <Setter Property="FontWeight" Value="Normal" />
                                                            <Setter Property="FontSize" Value="20" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding DataContext.Player.OcultarControles, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                                <Condition Binding="{Binding DataContext.Player.LetraAtual.Sincronizada, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="FontWeight" Value="Normal" />
                                                            <Setter Property="FontSize" Value="24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                            <Setter Property="Opacity" Value="1" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- EQUALIZADOR -->
        <Grid Background="Transparent" Visibility="{Binding Player.MostrarEqualizador,Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Background="{DynamicResource GradientBackground}" Opacity="0.2">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseLeftButtonUp">
                        <i:InvokeCommandAction Command="{Binding Player.FecharEqualizadorCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Grid>
            <Grid>
                <Grid.RenderTransform>
                    <TranslateTransform Y="100" />
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Player.MostrarEqualizador}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                From="100" To="0" Duration="0:0:0.10" />
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.10" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                From="0" To="100" Duration="0:0:0.10" />
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.10" />
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0.20" Value="{x:Static Visibility.Collapsed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Background="{DynamicResource GradientBackground}"
                        BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" VerticalAlignment="Bottom"
                        Style="{DynamicResource BorderClip}" CornerRadius="8,8,0,0" Width="750" Height="650">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,0">
                            <Button BorderThickness="0" Command="{Binding Player.FecharEqualizadorCommand}"
                                    Background="Transparent" Width="Auto" Height="40"
                                    Foreground="{DynamicResource TextPrimaryBrush}" Cursor="Hand"
                                    HorizontalAlignment="Center" ToolTip="{DynamicResource Str_Fechar}">
                                <Border Width="50" Height="5" Background="{DynamicResource TextMutedBrush}" Style="{StaticResource BorderCircular}" />
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="250" />
                            </Grid.RowDefinitions>

                            <!-- Bandas do Equalizador -->
                            <ItemsControl Grid.Row="0"  ItemsSource="{Binding Player.Bandas}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,0">
                                            <Slider Minimum="-20" Maximum="20"
                                                    Value="{Binding Ganho, Mode=TwoWay}" Width="Auto"
                                                    Orientation="Vertical" MinHeight="300"
                                                    Style="{StaticResource PrettySliderEqualizer}"
                                                    HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Frequencia, StringFormat={}{0} Hz}"
                                                       HorizontalAlignment="Center" FontSize="10"
                                                       FontFamily="{DynamicResource FonteJetBrains}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Presets -->
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Player.Presets}"
                                     SelectedValuePath="Indice"
                                     SelectedValue="{Binding Player.PresetSelecionadoIndice}"
                                     Background="Transparent" BorderThickness="0"
                                     Margin="5"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="True"
                                     HorizontalContentAlignment="Center">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Nome}" FontSize="14" FontFamily="{DynamicResource FonteJetBrains}" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="3" />
                                        <Setter Property="Padding" Value="10" />
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6" MinWidth="155" HorizontalAlignment="Center"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>