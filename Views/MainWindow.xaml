<Window x:Class="Project_Kitsune.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
        xmlns:vm="clr-namespace:Project_Kitsune.ViewModels"
        xmlns:views="clr-namespace:Project_Kitsune.Views"
        xmlns:converters="clr-namespace:Project_Kitsune.Converters"
        xmlns:viewmodels="clr-namespace:Project_Kitsune.ViewModels"
        xmlns:ctzex="urn:controlzex"
        mc:Ignorable="d"
        Title=""
        Height="700"
        WindowState="Normal"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Icon="/Resources/Icons/icon-logo.ico"
        AllowsTransparency="False"
        Background="Transparent"
        Width="1200" MinWidth="980" MinHeight="680">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LoadingViewModel}">
            <views:LoadingScreem />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShellViewModel}">
            <views:ShellView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.CacheMode>
            <BitmapCache RenderAtScale="1" />
        </Grid.CacheMode>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== CONTEÚDO (Loading / Shell) ===== -->
            <Grid ClipToBounds="True" Background="{DynamicResource SurfaceBrush}">
                <!--===== PAGINAS =====-->
                <ContentControl Content="{Binding CurrentView}" ClipToBounds="True" />
            </Grid>
        </Grid>
    </Grid>
</Window>