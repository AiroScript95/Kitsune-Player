<Window x:Class="Project_Kitsune.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
        xmlns:vm="clr-namespace:Project_Kitsune.ViewModels"
        xmlns:views="clr-namespace:Project_Kitsune.Views"
        xmlns:converters="clr-namespace:Project_Kitsune.Converters"
        xmlns:viewmodels="clr-namespace:Project_Kitsune.ViewModels"
        xmlns:ctzex="urn:controlzex"
        mc:Ignorable="d"
        Title="Kitsune Player"
        Height="700"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="Transparent"
        Focusable="True"
        Width="1200" MinWidth="980" MinHeight="680">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LoadingViewModel}">
            <views:LoadingScreem />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShellViewModel}">
            <views:ShellView />
        </DataTemplate>

        <ContextMenu  x:Key="MusicaContextMenu">
            <MenuItem ItemsSource="{Binding PlacementTarget.Tag.PlaylistsDisponiveis,
                      RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Header>
                    <Grid>
                        <TextBlock Text="{DynamicResource Str_AdicionarAPlaylist}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <iconPacks:PackIconBoxIcons Kind="RegularListPlus" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextPrimaryBrush}" Width="14" />
                    </Grid>
                </MenuItem.Header>
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Command"
                                Value="{Binding PlacementTarget.Tag.AdicionarAPlaylistCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Setter Property="CommandParameter">
                            <Setter.Value>
                                <MultiBinding Converter="{StaticResource MusicaEPlaylistConverter}">
                                    <Binding Path="PlacementTarget.DataContext"
                                             RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                    <Binding />
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </MenuItem.ItemContainerStyle>
                <MenuItem.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Name}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Name}" Value="Favoritos">
                                            <Setter Property="Text" Value="{DynamicResource Str_Favoritos}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </MenuItem.ItemTemplate>
            </MenuItem>

            <MenuItem Command="{Binding PlacementTarget.Tag.EditarMusicaCommand,
                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                      RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Header>
                    <Grid>
                        <TextBlock Text="{DynamicResource Str_Editar}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <iconPacks:PackIconBoxIcons Kind="SolidPencil" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextPrimaryBrush}" Width="14" />
                    </Grid>
                </MenuItem.Header>
            </MenuItem>

            <MenuItem Command="{Binding PlacementTarget.Tag.PedirEliminarMusicaCommand,
                      RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                      RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Header>
                    <Grid>
                        <TextBlock Text="{DynamicResource Str_Eliminar}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <iconPacks:PackIconBoxIcons Kind="SolidTrashAlt" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextError}" Width="14" />
                    </Grid>
                </MenuItem.Header>
            </MenuItem>
        </ContextMenu>

        <Style x:Key="WinCaptionStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="47" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="SingleBorderWindow" />
            <Setter Property="WindowChrome.WindowChrome">
                <Setter.Value>
                    <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" UseAeroCaptionButtons="False" GlassFrameThickness="-1" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Style>

    <Grid>
        <Grid.CacheMode>
            <BitmapCache RenderAtScale="1" />
        </Grid.CacheMode>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel x:Name="RootPanel" Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Margin="0" Height="Auto" VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- タイトル文字列（WindowChromeがnullのときも出たまま） -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0">
                    <TextBlock Text="Kitsune Player"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource FonteHiragino}"
                               VerticalAlignment="Center" Margin="8,0"
                               FontSize="12" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- トグルボタン（必要に応じて表示/非表示を切り替え可能） -->

                <Grid x:Name="PesquisaRoot" Grid.Column="1" Width="Auto" Margin="0,8,0,0"
                      WindowChrome.IsHitTestVisibleInChrome="True">

                    <TextBox x:Name="SearBar" Style="{StaticResource PesquisaTextBox}"
                             Width="360" Height="32" Grid.Column="1"
                             Text="{Binding TextoPesquisa, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{DynamicResource FonteInter}"
                             WindowChrome.IsHitTestVisibleInChrome="True"
                             GotKeyboardFocus="SearBar_GotKeyboardFocus"
                             PreviewKeyDown="SearBar_PreviewKeyDown">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ResultadosEncontradosCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <Popup PlacementTarget="{Binding ElementName=SearBar}"
                           Placement="Bottom" StaysOpen="True" Focusable="True"
                           AllowsTransparency="True" PopupAnimation="Fade">
                        <Popup.Resources>
                            <Style x:Key="SecaoPesquisa" TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                            <Style x:Key="CabecalhoPesquisa" TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                <Setter Property="Margin" Value="12,10,12,4" />
                            </Style>

                            <!-- botão sem o visual do Windows: só o fundo arredondado + hover -->
                            <Style x:Key="LinhaPesquisa" TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Fundo" Background="{TemplateBinding Background}"
                                                    CornerRadius="4" Margin="0" Padding="6">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource SurfaceOverlayBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- Musicas -->
                            <DataTemplate x:Key="ResultadoPesquisaTemplate">
                                <Border Background="Transparent" Padding="8,6" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceOverlayBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick"
                                                      Command="{Binding DataContext.TocarResultadoCommand, ElementName=PesquisaRoot}"
                                                      CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="46" Height="46" CornerRadius="4"
                                                Style="{StaticResource BorderClip}"
                                                Background="{DynamicResource SurfaceAltBrush}">
                                            <Grid>
                                                <Image Source="{Binding Image, Converter={StaticResource BytesParaImagemConverter},ConverterParameter=120}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Stretch="UniformToFill" />

                                                <iconPacks:PackIconBoxIcons Kind="RegularMusicAlt" Width="18" Height="18"
                                                                            Foreground="{DynamicResource TextMutedBrush}"
                                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                            Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Titulo}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Artista}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Button Grid.Column="2" Background="Transparent" BorderThickness="0"
                                                Padding="6" Cursor="Hand"
                                                Tag="{Binding DataContext.Player, ElementName=PesquisaRoot}"
                                                ContextMenu="{StaticResource MusicaContextMenu}"
                                                ContextMenuOpening="TresPontos_ContextMenuOpening"
                                                Click="TresPontos_Click">
                                            <iconPacks:PackIconBoxIcons Kind="SolidDotsVertical"
                                                                        Width="14" Height="14"
                                                                        Foreground="{DynamicResource TextMutedBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>

                            <!-- Artistas e Álbuns -->
                            <DataTemplate x:Key="GrupoResultadoTemplate">
                                <Button Style="{StaticResource LinhaPesquisa}"
                                        Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="46" Height="46" CornerRadius="4" ClipToBounds="True"
                                                Style="{StaticResource BorderClip}"
                                                Background="{DynamicResource SurfaceAltBrush}">
                                            <Grid>
                                                <Image Source="{Binding Capa, Converter={StaticResource BytesParaImagemConverter}, ConverterParameter=120}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Stretch="UniformToFill" />
                                                <iconPacks:PackIconBoxIcons Kind="RegularMusicAlt" Width="18" Height="18"
                                                                            Foreground="{DynamicResource TextMutedBrush}"
                                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                            Visibility="{Binding Capa, Converter={StaticResource NullToVisibilityConverter}}" />
                                            </Grid>
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="{Binding Nome}" Margin="12,0"
                                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                                   FontFamily="{StaticResource FonteInter}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Button>
                            </DataTemplate>

                            <!-- Playlists: sem capa nem contagem -->
                            <DataTemplate x:Key="PlaylistResultadoTemplate">
                                <Button Style="{StaticResource LinhaPesquisa}"
                                        Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="46" Height="46" CornerRadius="4" Style="{StaticResource BorderClip}"
                                                Background="{DynamicResource SurfaceAltBrush}">

                                            <iconPacks:PackIconBoxIcons Kind="SolidMusicLibrary" Width="18" Height="18"
                                                                        Foreground="{DynamicResource TextMutedBrush}"
                                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" FontFamily="{StaticResource FonteInter}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Name}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Name}" Value="Favoritos">
                                                            <Setter Property="Text" Value="{DynamicResource Str_Favoritos}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </Popup.Resources>

                        <Popup.Style>
                            <Style TargetType="Popup">
                                <Setter Property="IsOpen" Value="{Binding PesquisaAberta, Mode=OneWay}" />
                            </Style>
                        </Popup.Style>
                        <Grid  Width="{Binding ActualWidth, ElementName=SearBar}">

                            <Border x:Name="Container" Width="auto"
                                    Margin="0,4,0,0" CornerRadius="8" BorderThickness="0.5" BorderBrush="{DynamicResource BorderBrush2}"
                                    Background="{DynamicResource GradientBackground}" Padding="4">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource SecaoPesquisa}" Tag="{Binding ResultadosMusica.Count}">
                                        <ItemsControl ItemsSource="{Binding ResultadosMusica}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="Linha" CornerRadius="4" Margin="0" Background="Transparent" Style="{StaticResource BorderClip}">
                                                        <ContentPresenter Content="{Binding}"
                                                                          ContentTemplate="{StaticResource ResultadoPesquisaTemplate}" />
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <Trigger SourceName="Linha" Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Linha" Property="Background" Value="{DynamicResource SurfaceOverlayBrush}" />
                                                        </Trigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource SecaoPesquisa}" Tag="{Binding ResultadosArtistas.Count}">
                                        <ItemsControl ItemsSource="{Binding ResultadosArtistas}"
                                                      Tag="{Binding AbrirArtistaCommand}"
                                                      ItemTemplate="{StaticResource GrupoResultadoTemplate}" />
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource SecaoPesquisa}" Tag="{Binding ResultadosAlbuns.Count}">
                                        <ItemsControl ItemsSource="{Binding ResultadosAlbuns}"
                                                      Tag="{Binding AbrirAlbumCommand}"
                                                      ItemTemplate="{StaticResource GrupoResultadoTemplate}" />
                                    </StackPanel>

                                    <StackPanel Style="{StaticResource SecaoPesquisa}" Tag="{Binding ResultadosPlaylists.Count}">
                                        <ItemsControl ItemsSource="{Binding ResultadosPlaylists}"
                                                      Tag="{Binding AbrirPlaylistCommand}"
                                                      ItemTemplate="{StaticResource PlaylistResultadoTemplate}" />
                                    </StackPanel>
                                    <Grid Margin="16,8">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter  Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding ResultadosMusica.Count}" Value="0" />
                                                            <Condition Binding="{Binding ResultadosArtistas.Count}" Value="0" />
                                                            <Condition Binding="{Binding ResultadosAlbuns.Count}" Value="0" />
                                                            <Condition Binding="{Binding ResultadosPlaylists.Count}" Value="0" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter  Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <TextBlock Text="Sem Resultados..." Foreground="{DynamicResource TextMutedBrush}" FontSize="12" FontFamily="{StaticResource FonteInter}" />
                                        <!--<iconPacks:PackIconBoxIcons Kind="RegularSearch" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />-->
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Popup>
                </Grid>

                <!-- コントロールボックス（★ UseCustomTitleBar が False のときは非表示にする） -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0" Background="Transparent">

                    <!-- 最小化 -->
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource WinCaptionStyle}"
                            FontFamily="Segoe MDL2 Assets" Content="&#xE921;"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Minimize_Click"
                            ToolTip="最小化" />

                    <!-- 最大化 -->
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource WinCaptionStyle}"
                            FontFamily="Segoe MDL2 Assets" Content="&#xE922;"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Maximize_Click"
                            ToolTip="最大化" />

                    <!-- 閉じる -->
                    <Button x:Name="CloseButton"
                            Style="{StaticResource WinCaptionStyle}"
                            FontFamily="Segoe MDL2 Assets" Content="&#xE8BB;"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Close_Click"
                            ToolTip="閉じる" />
                </StackPanel>
            </Grid>
        </DockPanel>
        <!-- ===== CONTEÚDO (Loading / Shell) ===== -->
        <Grid Grid.Row="1" ClipToBounds="True" Background="{DynamicResource SurfaceBrush}" Margin="0,4,0,0"
              PreviewMouseDown="Window_PreviewMouseDown">
            <!--===== PAGINAS =====-->
            <ContentControl Content="{Binding CurrentView}" ClipToBounds="True" />
        </Grid>
    </Grid>
</Window>