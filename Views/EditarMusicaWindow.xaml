<Window x:Class="Project_Kitsune.Views.EditarMusicaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:Project_Kitsune.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title=""
        Width="380" Height="400"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        ResizeMode="NoResize">
    <Grid>
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FonteInter}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxBaseBaseStyle}">
                <Setter Property="Width" Value="auto"/>
                <Setter Property="Height" Value="auto"/>
                <Setter Property="Margin" Value="0,8,0,16"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="FontFamily" Value="{StaticResource FonteInter}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{DynamicResource Str_Editar}" Margin="24,0" Style="{StaticResource ConfigSectionTitle}"/>
        <StackPanel Grid.Row="1" Margin="24,0" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource Str_Titulo}" />
            <TextBox Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="{DynamicResource Str_Artista}" />
            <TextBox Text="{Binding Artista, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="{DynamicResource Str_Album}" />
            <TextBox Text="{Binding Album, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16">
            <Button Content="{DynamicResource Str_Cancelar}" Click="Cancelar_Click"
                    Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextSecondaryBrush}"
                    BorderThickness="0" Width="auto" Height="Auto" Padding="16,8" Margin="0,0,16,0" hc:BorderElement.CornerRadius="8"
                    FontFamily="{DynamicResource FonteInter}"/>
            <Button Content="{DynamicResource Str_Concluir}" Command="{Binding SalvarCommand}" Style="{StaticResource ConfigActionButton}"/>
        </StackPanel>
    </Grid>
</Window>