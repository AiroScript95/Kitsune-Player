<UserControl x:Class="Project_Kitsune.Views.ShellPages.AlbunsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Project_Kitsune.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Style="{StaticResource TransicaoEntrada}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="30,10"
                   Text="{DynamicResource Str_Albuns}"
                   FontSize="24" FontWeight="Bold"
                   FontFamily="{StaticResource FonteHiragino}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   VerticalAlignment="Center" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ItemsControl Grid.Column="0" Margin="10" ItemsSource="{Binding Albuns}"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                <i:Interaction.Behaviors>
                    <behaviors:ScrollGrupoViewBehavior ScrollToItem="{Binding GrupoParaScroll}" />
                </i:Interaction.Behaviors>
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="320" Height="120" Margin="6"
                                CornerRadius="16"
                                ClipToBounds="True"
                                Style="{StaticResource BorderClip}"
                                BorderThickness="0"
                                Background="Transparent"
                                Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick"
                                              Command="{Binding DataContext.AbrirArtistaCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}" />
                            </Border.InputBindings>

                            <Grid>
                                <Grid Background="{DynamicResource GradientBackground}" Opacity="0.5" />
                                <Grid Margin="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="60*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Capa -->
                                    <Border Grid.Column="0" CornerRadius="8" Width="100" Height="100"
                                            Background="{DynamicResource SurfaceRaisedBrush}"
                                            Style="{StaticResource BorderClip}"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding Capa, Converter={StaticResource BytesParaImagemConverter}, ConverterParameter=240}"
                                                   Stretch="UniformToFill"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                            <iconPacks:PackIconBoxIcons Kind="RegularUser"
                                                                        Width="32" Height="32"
                                                                        Foreground="{DynamicResource TextMutedBrush}"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="{Binding Capa, Converter={StaticResource NullToVisibilityConverter}}" />
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Column="1" Margin="16,0,0,0">
                                        <!-- Nº de músicas -->
                                        <Border Background="#00000090" CornerRadius="10" Padding="8,2" Margin="6"
                                                HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding NumMusicas, StringFormat={}{0:D2}}"
                                                       FontFamily="{StaticResource FonteInter}"
                                                       FontSize="12" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </Border>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Nome}"
                                                       FontSize="16" FontWeight="DemiBold"
                                                       FontFamily="{StaticResource FonteInter}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,8,40,4" />

                                            <ItemsControl ItemsSource="{Binding ListaMusicas}" Margin="0,5">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                                            <iconPacks:PackIconBoxIcons Kind="RegularMusicAlt" Width="12" Height="12"
                                                                                        Foreground="{DynamicResource TextMutedBrush}" />
                                                            <TextBlock Margin="8,0" Text="{Binding}"
                                                                       FontSize="12" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Grid.Column="1" CornerRadius="8" Style="{DynamicResource BorderClip}">
                <Grid ClipToBounds="True">
                    <Grid Background="{DynamicResource SurfaceAltBrush}" Opacity="0.65"></Grid>
                    <ItemsControl ItemsSource="{Binding Alfabeto}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" Width="30">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold"
                                           FontFamily="{StaticResource FonteInter}"
                                           HorizontalAlignment="Center" Cursor="Hand" Margin="2,3">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource TextPrimaryBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="MouseLeftButtonDown">
                                            <i:InvokeCommandAction Command="{Binding DataContext.SaltarParaLetraCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                   CommandParameter="{Binding}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>