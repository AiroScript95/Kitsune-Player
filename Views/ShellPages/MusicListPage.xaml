<UserControl x:Class="Project_Kitsune.Views.ShellPages.MusicListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:Project_Kitsune.Views.ShellPages"
             xmlns:controls="clr-namespace:Project_Kitsune.Views.Controls"
             xmlns:converters="clr-namespace:Project_Kitsune.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:viewmodels="clr-namespace:Project_Kitsune.ViewModels"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Project_Kitsune.Behaviors"
             d:DataContext="{d:DesignInstance Type=viewmodels:ShellViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000">

    <UserControl.Resources>
        <DataTemplate x:Key="ListaMusicaTemplate">
            <Border CornerRadius="8" Style="{DynamicResource BorderClip}"
                    MouseLeftButtonUp="StackPanel_MouseLeftButtonUp" BorderThickness="1"
                    ContextMenuOpening="ContextMenu_Opening"
                    Tag="{Binding DataContext.PlayerViewModel, RelativeSource={RelativeSource AncestorType=UserControl}}">

                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem ItemsSource="{Binding PlacementTarget.Tag.PlaylistsDisponiveis,
                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Header>
                                <Grid>
                                    <TextBlock Text="{DynamicResource Str_AdicionarAPlaylist}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <iconPacks:PackIconBoxIcons Kind="RegularListPlus" HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource TextPrimaryBrush}" Width="14" />
                                </Grid>
                            </MenuItem.Header>
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Command"
                                            Value="{Binding PlacementTarget.Tag.AdicionarAPlaylistCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Setter Property="CommandParameter">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource MusicaEPlaylistConverter}">
                                                <Binding Path="PlacementTarget.DataContext"
                                                         RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                                <Binding />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </MenuItem.ItemContainerStyle>
                            <MenuItem.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Name}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Name}" Value="Favoritos">
                                                        <Setter Property="Text" Value="{DynamicResource Str_Favoritos}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </MenuItem.ItemTemplate>
                        </MenuItem>

                        <MenuItem Command="{Binding PlacementTarget.Tag.EditarMusicaCommand,
                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Header>
                                <Grid>
                                    <TextBlock Text="{DynamicResource Str_Editar}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <iconPacks:PackIconBoxIcons Kind="SolidPencil" HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource TextPrimaryBrush}" Width="14" />
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>

                        <MenuItem Command="{Binding PlacementTarget.Tag.PedirEliminarMusicaCommand,
                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Header>
                                <Grid>
                                    <TextBlock Text="{DynamicResource Str_Eliminar}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <iconPacks:PackIconBoxIcons Kind="SolidTrashAlt" HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource TextError}" Width="14" />
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid Opacity="0.65">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                <Binding />
                                                <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                         RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="Background" Value="{DynamicResource GradientBackground}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                    </Grid>
                    <Grid Margin="8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="100*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="60"
                                Height="60"
                                CornerRadius="8"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                Style="{StaticResource BorderClip}"
                                ClipToBounds="True">
                            <Grid ClipToBounds="True">
                                <Image Source="{Binding Image, Converter={StaticResource BytesParaImagemConverter},ConverterParameter=120}"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                                <iconPacks:PackIconBoxIcons Kind="RegularMusic"
                                                            Width="18"
                                                            Height="18"
                                                            Foreground="{DynamicResource TextMutedBrush}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="left"
                                    Margin="12,0"
                                    Background="Transparent">
                            <TextBlock Text="{Binding Titulo}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       FontFamily="{StaticResource FonteInter}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource TextPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                        <Binding />
                                                        <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource AccentLightBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,4">
                                <TextBlock Text="{Binding Artista}"
                                           FontSize="12"
                                           MaxWidth="150"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource FonteInter}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="•"
                                           Margin="4,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Album}"
                                           FontFamily="{StaticResource FonteInter}"
                                           FontSize="12"
                                           MaxWidth="150"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                        BorderThickness="0"
                                        Visibility="{Binding TemLetraDisponivel, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        CornerRadius="5"
                                        Margin="0,0,6,0"
                                        BorderBrush="{DynamicResource SecondaryBorderBrush}">
                                    <TextBlock Text="{DynamicResource Str_Letras}"
                                               FontFamily="{StaticResource FonteInter}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="6,0" />
                                </Border>
                                <TextBlock Text="{Binding DuracaoArredondada}"
                                           FontFamily="{StaticResource FonteInter}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="30,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.OrdemAtual,
                                                     RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                     Value="MaisTocada">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="{Binding VezesTocada}"
                                       FontSize="14"
                                       FontFamily="{StaticResource FonteInter}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <iconPacks:PackIconBoxIcons Grid.Column="3"
                                                    Margin="15,0"
                                                    Width="18"
                                                    Height="18"
                                                    VerticalAlignment="Center">
                            <iconPacks:PackIconBoxIcons.Style>
                                <Style TargetType="iconPacks:PackIconBoxIcons">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextMutedBrush}" />
                                    <Setter Property="Kind"
                                            Value="RegularEqualizer" />
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                    <Binding />
                                                    <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                             RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Kind"
                                                    Value="SolidWaveform" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconBoxIcons.Style>
                        </iconPacks:PackIconBoxIcons>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="GridMusicaTemplate">
            <Border CornerRadius="8"
                    Width="140"
                    Height="auto"
                    Margin="4" Style="{StaticResource BorderClip}"
                    MouseLeftButtonUp="StackPanel_MouseLeftButtonUp"
                    ContextMenuOpening="ContextMenu_Opening"
                    Tag="{Binding DataContext.Player, RelativeSource={RelativeSource AncestorType=UserControl}}">

                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem ItemsSource="{Binding PlacementTarget.Tag.PlaylistsDisponiveis,
                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Header>
                                <Grid>
                                    <TextBlock Text="{DynamicResource Str_AdicionarAPlaylist}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <iconPacks:PackIconBoxIcons Kind="RegularListPlus" HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource TextPrimaryBrush}" Width="14" />
                                </Grid>
                            </MenuItem.Header>
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Command"
                                            Value="{Binding PlacementTarget.Tag.AdicionarAPlaylistCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Setter Property="CommandParameter">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource MusicaEPlaylistConverter}">
                                                <Binding Path="PlacementTarget.DataContext"
                                                         RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                                <Binding />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </MenuItem.ItemContainerStyle>
                            <MenuItem.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Name}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Name}" Value="Favoritos">
                                                        <Setter Property="Text" Value="{DynamicResource Str_Favoritos}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </MenuItem.ItemTemplate>
                        </MenuItem>

                        <MenuItem Command="{Binding PlacementTarget.Tag.EditarMusicaCommand,
                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Header>
                                <Grid>
                                    <TextBlock Text="{DynamicResource Str_Editar}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <iconPacks:PackIconBoxIcons Kind="SolidPencil" HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource TextPrimaryBrush}" Width="14" />
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>

                        <MenuItem Command="{Binding PlacementTarget.Tag.PedirEliminarMusicaCommand,
                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Header>
                                <Grid>
                                    <TextBlock Text="{DynamicResource Str_Eliminar}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <iconPacks:PackIconBoxIcons Kind="SolidTrashAlt" HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource TextError}" Width="14" />
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid Opacity="0.85">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background"
                                        Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                <Binding />
                                                <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                         RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="Background" Value="{DynamicResource GradientBackground}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                    </Grid>
                    <StackPanel Margin="6,8">
                        <Border MinWidth="120" MinHeight="120"
                                MaxWidth="130" MaxHeight="120"
                                CornerRadius="8"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                Style="{StaticResource BorderClip}"
                                ClipToBounds="True">
                            <Grid ClipToBounds="True">
                                <Image Source="{Binding Image, Converter={StaticResource BytesParaImagemConverter},ConverterParameter=240}"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                                <iconPacks:PackIconBoxIcons Kind="RegularMusic"
                                                            Width="24"
                                                            Height="24"
                                                            Foreground="{DynamicResource TextMutedBrush}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding Titulo}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   FontFamily="{StaticResource FonteInter}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource TextPrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                    <Binding />
                                                    <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                             RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource AccentLightBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Artista}"
                                   FontSize="11"
                                   FontFamily="{StaticResource FonteInter}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Style="{StaticResource TransicaoEntrada}"
          ClipToBounds="True">
        <!-- Conteudo -->
        <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="70*" />
            </Grid.ColumnDefinitions>

            <!-- ===== PAINEL LATERAL: capa + controlos ===== -->
            <Grid Grid.Column="0" ClipToBounds="True">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Width"
                                Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PlayerViewModel.MusicaAtual, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"
                                         Value="Visible">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                                             To="380"
                                                             Duration="0:0:0.05">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>

                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                                             To="0"
                                                             Duration="0:0:0.05">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseIn" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid Background="{DynamicResource SurfaceAltBrush}" Opacity="0.985"></Grid>
                <controls:PlayerControl />
            </Grid>

            <!-- ===== LISTA À DIREITA ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="24,0">
                    <TextBlock Text="{DynamicResource Str_Musicas}"
                               FontSize="24"
                               FontWeight="Bold"
                               FontFamily="{StaticResource FonteHiragino}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left" />
                    <Button Command="{Binding MostrarPainelOrdenacaoCommand}" Style="{DynamicResource IconButtonSmall}"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                        <iconPacks:PackIconBoxIcons2 Kind="RegularSortDown" Width="20" Height="Auto" />
                    </Button>
                </Grid>
                <Grid Grid.Row="1"
                      Margin="14,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0"
                             ClipToBounds="True"
                             ItemsSource="{Binding Musicas}"
                             Padding="5,0,10,0"
                             ItemContainerStyle="{StaticResource HoverListBoxItemStyle}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             Background="Transparent"
                             BorderThickness="0" Margin="0,0,10,0">
                        <i:Interaction.Behaviors>
                            <behaviors:ScrollIntoViewBehavior ScrollToItem="{Binding MusicaParaScroll}" />
                        </i:Interaction.Behaviors>
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
                                <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
                                <Setter Property="ItemTemplate" Value="{StaticResource ListaMusicaTemplate}" />
                                <Setter Property="ItemsPanel">
                                    <Setter.Value>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel Orientation="Vertical" />
                                        </ItemsPanelTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FormatoLista}" Value="Grid">
                                        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item" />
                                        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
                                        <Setter Property="ItemTemplate" Value="{StaticResource GridMusicaTemplate}" />
                                        <Setter Property="ItemsPanel">
                                            <Setter.Value>
                                                <ItemsPanelTemplate>
                                                    <vwp:VirtualizingWrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                    </ListBox>
                    <Border Grid.Column="1" CornerRadius="8" Style="{DynamicResource BorderClip}">
                        <Grid ClipToBounds="True">
                            <Grid Background="{DynamicResource SurfaceAltBrush}" Opacity="0.65"></Grid>
                            <ItemsControl ItemsSource="{Binding Alfabeto}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Width" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OrdemAtual}" Value="Alfabetica">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Width" To="30" Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <QuadraticEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.25">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <QuadraticEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold"
                                                   FontFamily="{StaticResource FonteInter}"
                                                   HorizontalAlignment="Center" Cursor="Hand" Margin="2,3">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource TextMutedBrush}" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource TextPrimaryBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="MouseLeftButtonDown">
                                                    <i:InvokeCommandAction Command="{Binding DataContext.SaltarParaLetraCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                           CommandParameter="{Binding}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
                <Border Grid.Row="2"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource BorderBrush2}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Height"
                                    Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EstaCarregandoMusicas, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             Value="Visible">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Height" To="60" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Height" To="0" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction>
                                                        <QuadraticEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <hc:LoadingCircle Height="30"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{DynamicResource Str_Carregar_biblio}"
                                   Margin="20,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontFamily="{StaticResource FonteInter}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <!--Painel Ordenação-->
        <Grid Background="Transparent" Visibility="{Binding MostrarOrdenacao,Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Background="Transparent">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseLeftButtonDown">
                        <i:InvokeCommandAction Command="{Binding FecharPainelOrdenacaoCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Grid>
            <Grid HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="0,60,24,0" RenderTransformOrigin="1,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrarOrdenacao}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.95" To="1" Duration="0:0:0.10" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.95" To="1" Duration="0:0:0.10" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0.20" Value="{x:Static Visibility.Collapsed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="0.95" Duration="0:0:0.10" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="0.95" Duration="0:0:0.10" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RenderTransform>
                    <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                </Grid.RenderTransform>
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10"
                        MinWidth="240" Padding="4,8" Style="{StaticResource BorderClip}"
                        BorderThickness="1" BorderBrush="{DynamicResource BorderBrush2}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.4" />
                    </Border.Effect>
                    <Grid>
                        <Grid.Resources>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource IconRadioButton}">
                                <Setter Property="Height" Value="36" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                            <Style TargetType="iconPacks:PackIconBoxIcons">
                                <Setter Property="Width" Value="14" />
                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <Setter Property="HorizontalAlignment" Value="Left" />
                            </Style>
                            <Style TargetType="iconPacks:PackIconBoxIcons2">
                                <Setter Property="Width" Value="14" />
                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <Setter Property="HorizontalAlignment" Value="Left" />
                            </Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource FonteInter}" />
                                <Setter Property="FontSize" Value="14" />
                                <Setter Property="Margin" Value="20,0" />
                            </Style>
                        </Grid.Resources>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_MusicasOrdenadasPor}" FontFamily="{StaticResource FonteInter}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,8" HorizontalAlignment="Center" />
                            <StackPanel  ClipToBounds="True">
                                <RadioButton Checked="Ordenacao_Changed"
                                             GroupName="Ordenacao"
                                             x:Name="RadioAlfabetica">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconBoxIcons2 Kind="RegularSortAZ" />
                                        <TextBlock Text="{DynamicResource Str_Alfabetica}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Checked="Ordenacao_Changed"
                                             GroupName="Ordenacao"
                                             x:Name="RadioMaisRecente">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconBoxIcons Kind="RegularClock12" />
                                        <TextBlock Text="{DynamicResource Str_Mais_recente}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Checked="Ordenacao_Changed"
                                             GroupName="Ordenacao"
                                             x:Name="RadioMaisTocada">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconBoxIcons Kind="RegularFireAlt" />
                                        <TextBlock Text="{DynamicResource Str_Mais_Tocada}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Checked="Ordenacao_Changed"
                                             GroupName="Ordenacao"
                                             x:Name="RadioDuracao">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconBoxIcons Kind="RegularHourglass" />
                                        <TextBlock Text="{DynamicResource Str_Duracao}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Checked="Ordenacao_Changed"
                                             GroupName="Ordenacao"
                                             x:Name="RadioAleatorio">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconBoxIcons Kind="RegularShuffle" />
                                        <TextBlock Text="{DynamicResource Str_Aleatorio}" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                            <Border Background="{DynamicResource SurfaceAltBrush}" Width="Auto" Height="2" CornerRadius="2" />
                            <StackPanel>
                                <RadioButton Checked="Ordenacao_Changed"
                                             GroupName="Direcao"
                                             x:Name="RadioAscendente">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconRemixIcon Kind="ArrowUpLongLine" />
                                        <TextBlock Text="{DynamicResource Str_Ascendente}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Checked="Ordenacao_Changed"
                                             GroupName="Direcao"
                                             x:Name="RadioDescendete">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconRemixIcon Kind="ArrowDownLongLine" />
                                        <TextBlock Text="{DynamicResource Str_Descendente}" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>