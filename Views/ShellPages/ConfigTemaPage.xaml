<UserControl x:Class="Project_Kitsune.Views.ShellPages.ConfigTemaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:converter="clr-namespace:Project_Kitsune.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:Project_Kitsune.Views.ShellPages"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:vm="clr-namespace:Project_Kitsune.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900">
    <UserControl.Resources>
        <converter:StringParaImagemConverter x:Key="StringParaImagemConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Style="{StaticResource TransicaoEntrada}"
          Background="{DynamicResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="100" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Button Command="{Binding VoltarCommand}"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderThickness="0"
                    Width="40" Height="40"
                    hc:BorderElement.CornerRadius="50"
                    Foreground="{DynamicResource TextOnAccentBrush}"
                    Margin="10">
                <iconPacks:PackIconBoxIcons Kind="SolidUndo" />
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                <RadioButton x:Name="RadioList" Style="{StaticResource IconFormat}" Checked="FormatoSelect_Checked">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularList" />
                        <TextBlock Text="{DynamicResource Str_Lista}" FontFamily="{StaticResource FonteInter}" Margin="10,0" FontSize="12" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="RadioGrid" Style="{StaticResource IconFormat}" Checked="FormatoSelect_Checked">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="RegularBlocks" />
                        <TextBlock Text="{DynamicResource Str_Grade}" FontFamily="{StaticResource FonteInter}" Margin="10,0" FontSize="12" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
            <Border Width="600" Height="350" Background="{DynamicResource GradientBackground}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource BorderClip}">
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Border}" Value="Normal">
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Border}" Value="Color">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Border}" Value="Color2">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentAltBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Border}" Value="Color3">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentTertiaryBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Grid.Column="1"></Grid>
                    <Grid Grid.Row="1" Grid.Column="0">
                        <Grid.Resources>
                            <Style TargetType="iconPacks:PackIconBoxIcons">
                                <Setter Property="Width" Value="12" />
                            </Style>
                        </Grid.Resources>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <iconPacks:PackIconBoxIcons Kind="SolidMusic" Margin="0,6" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <iconPacks:PackIconBoxIcons Kind="SolidMusicLibrary" Margin="0,6" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <iconPacks:PackIconBoxIcons Kind="SolidHeart" Margin="0,6" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <iconPacks:PackIconBoxIcons Kind="SolidBlock" Margin="0,6" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <iconPacks:PackIconBoxIcons Kind="SolidBlock" Margin="0,6" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,16">
                            <iconPacks:PackIconBoxIcons Kind="SolidCog" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Grid.Column="1" CornerRadius="5,5,10,0"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush2}"
                            BorderThickness="1">
                        <Grid>
                            <Border
                                Visibility="{Binding TemImage,Converter={StaticResource BooleanToVisibilityConverter}}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource BorderClip}">
                                <Image ClipToBounds="True" Stretch="UniformToFill" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Source="{Binding ImagemBackground, Converter={StaticResource StringParaImagemConverter}}" />
                            </Border>
                            <Grid Background="{DynamicResource GradientBackground}" Opacity="0.5"></Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <DataTemplate x:Key="ListaPreviewTemplate">
                                        <StackPanel Height="40" Margin="10,0" Orientation="Horizontal">
                                            <Grid Width="320" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="{DynamicResource SurfaceRaisedBrush}" Width="35" Height="35"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="5">
                                                        <iconPacks:PackIconBoxIcons Kind="SolidMusic" HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                                    </Border>
                                                    <StackPanel Margin="10">
                                                        <Border Height="6" Width="80" CornerRadius="2"
                                                                Background="{DynamicResource TextMutedBrush}"
                                                                HorizontalAlignment="Left" Margin="0,0,0,4" />
                                                        <Border Height="4" Width="40" CornerRadius="2"
                                                                Background="{DynamicResource TextMutedBrush}" Opacity="0.6"
                                                                HorizontalAlignment="Left" Margin="0,0,0,10" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <iconPacks:PackIconBoxIcons Kind="SolidWaveform" HorizontalAlignment="Right"
                                                                            VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>

                                    <DataTemplate x:Key="GridPreviewTemplate">
                                        <Border Width="70" Margin="4">
                                            <StackPanel>
                                                <Border Width="60" Height="60" CornerRadius="5"
                                                        Background="{DynamicResource SurfaceRaisedBrush}">
                                                    <iconPacks:PackIconBoxIcons Kind="SolidMusic" HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                                </Border>
                                                <Border Height="6" Width="50" CornerRadius="2"
                                                        Background="{DynamicResource TextMutedBrush}"
                                                        HorizontalAlignment="Left" Margin="0,6,0,4" />
                                                <Border Height="4" Width="30" CornerRadius="2"
                                                        Background="{DynamicResource TextMutedBrush}" Opacity="0.6"
                                                        HorizontalAlignment="Left" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </Grid.Resources>

                                <Grid Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}">
                                    <StackPanel Margin="10">
                                        <!-- Capa (placeholder) -->
                                        <Border Height="160" CornerRadius="4"
                                                Background="{DynamicResource SurfaceRaisedBrush}"
                                                Margin="0,0,0,8" />

                                        <!-- Título/artista (placeholder) -->
                                        <Border Height="8" Width="100" CornerRadius="2"
                                                Background="{DynamicResource TextMutedBrush}"
                                                HorizontalAlignment="Left" Margin="0,0,0,4" />
                                        <Border Height="6" Width="60" CornerRadius="2"
                                                Background="{DynamicResource TextMutedBrush}" Opacity="0.6"
                                                HorizontalAlignment="Left" Margin="0,0,0,10" />

                                        <!-- Seek bar (placeholder) -->
                                        <Border Height="3" CornerRadius="2"
                                                Background="{DynamicResource TextMutedBrush}" Opacity="0.4"
                                                Margin="0,10,0,10" />

                                        <!-- Controlos -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,20">
                                            <iconPacks:PackIconBoxIcons Kind="SolidSkipPrevious" Width="14" Margin="4,0" VerticalAlignment="Center"
                                                                        Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <iconPacks:PackIconBoxIcons Kind="SolidPlayCircle" Width="20" Height="20" Margin="4,0" VerticalAlignment="Center"
                                                                        Foreground="{DynamicResource AccentBrush}" />
                                            <iconPacks:PackIconBoxIcons Kind="SolidSkipNext" Width="14" Margin="4,0" VerticalAlignment="Center"
                                                                        Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>

                                        <!-- Letras / shuffle-repeat -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <iconPacks:PackIconBoxIcons Kind="SolidShuffle" Width="12" Margin="6,0"
                                                                        Foreground="{DynamicResource TextMutedBrush}" />
                                            <Border Width="60" CornerRadius="6" Height="14" Background="{DynamicResource SurfaceBrush}"></Border>
                                            <iconPacks:PackIconBoxIcons Kind="SolidRepeat" Width="12" Margin="6,0"
                                                                        Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl Grid.Column="1" Margin="5,15">
                                    <ItemsControl.ItemsSource>
                                        <x:Array Type="{x:Type sys:Int32}">
                                            <sys:Int32>0</sys:Int32>
                                            <sys:Int32>1</sys:Int32>
                                            <sys:Int32>2</sys:Int32>
                                            <sys:Int32>3</sys:Int32>
                                            <sys:Int32>4</sys:Int32>
                                            <sys:Int32>5</sys:Int32>
                                        </x:Array>
                                    </ItemsControl.ItemsSource>
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="ItemTemplate" Value="{StaticResource ListaPreviewTemplate}" />
                                            <Setter Property="ItemsPanel">
                                                <Setter.Value>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Vertical" />
                                                    </ItemsPanelTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FormatoLista}" Value="Grid">
                                                    <Setter Property="ItemTemplate" Value="{StaticResource GridPreviewTemplate}" />
                                                    <Setter Property="ItemsPanel">
                                                        <Setter.Value>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                                            </ItemsPanelTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.Resources>
                <Style TargetType="RadioButton" x:Key="IconRadioButton">
                    <Setter Property="Width" Value="36" />
                    <Setter Property="Height" Value="36" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Margin" Value="4,0" />
                </Style>
                <Style TargetType="Viewbox">
                    <Setter Property="Width" Value="20" />
                    <Setter Property="Height" Value="20" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Grid.Resources>
            <Border HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource BorderCircular}"
                    Background="{DynamicResource SurfaceRaisedBrush}" Margin="20,0" Padding="4,8">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RadioNormal" GroupName="Border" Checked="BorderSelect_Checked">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource IconRadioButton}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border BorderThickness="3" CornerRadius="30" BorderBrush="{DynamicResource BorderBrush2}" Background="{DynamicResource SurfaceBrush}"
                                                    SnapsToDevicePixels="True" x:Name="border">
                                                <ContentPresenter HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" x:Name="content" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                    <RadioButton x:Name="RadioColor" GroupName="Border" Checked="BorderSelect_Checked">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource IconRadioButton}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border BorderThickness="3" CornerRadius="30" BorderBrush="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceBrush}"
                                                    SnapsToDevicePixels="True" x:Name="border">
                                                <ContentPresenter HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" x:Name="content" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                    <RadioButton x:Name="RadioColor2" GroupName="Border" Checked="BorderSelect_Checked">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource IconRadioButton}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border BorderThickness="3" CornerRadius="30" BorderBrush="{DynamicResource AccentAltBrush}" Background="{DynamicResource SurfaceBrush}"
                                                    SnapsToDevicePixels="True" x:Name="border">
                                                <ContentPresenter HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" x:Name="content" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                    <RadioButton x:Name="RadioColor3" GroupName="Border" Checked="BorderSelect_Checked">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource IconRadioButton}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border BorderThickness="3" CornerRadius="30" BorderBrush="{DynamicResource AccentTertiaryBrush}" Background="{DynamicResource SurfaceBrush}"
                                                    SnapsToDevicePixels="True" x:Name="border">
                                                <ContentPresenter HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" x:Name="content" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                </StackPanel>
            </Border>
            <Border Margin="20,0" Padding="4,8" Style="{StaticResource BorderCircular}" Background="{DynamicResource SurfaceRaisedBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">

                    <RadioButton x:Name="RadioAsa" GroupName="tema" ToolTip="Asa"
                                 Checked="TemaSelect_Checked" Foreground="#A0917D">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource IconRadioButton}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border BorderThickness="3" CornerRadius="30" SnapsToDevicePixels="True" x:Name="border">
                                                <Border.BorderBrush>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#D9683F" Offset="0" />
                                                        <GradientStop Color="#C99A2E" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.BorderBrush>
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#FDF8F2" Offset="0" />
                                                        <GradientStop Color="#ECE0CE" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <ContentPresenter HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" x:Name="content" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <RadioButton x:Name="RadioKuko" GroupName="tema" ToolTip="Kuko"
                                 Checked="TemaSelect_Checked" Foreground="#A0917D">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource IconRadioButton}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border BorderThickness="3" CornerRadius="30" SnapsToDevicePixels="True" x:Name="border">
                                                <Border.BorderBrush>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#E8637A" Offset="0" />
                                                        <GradientStop Color="#8B5FA8" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.BorderBrush>
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#FAF1EC" Offset="0" />
                                                        <GradientStop Color="#E5C4B4" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <ContentPresenter HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" x:Name="content" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <RadioButton x:Name="RadioNogitsune" GroupName="tema" ToolTip="Nogitsune"
                                 Checked="TemaSelect_Checked" Foreground="#A0917D">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource IconRadioButton}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border BorderThickness="3" CornerRadius="30" SnapsToDevicePixels="True" x:Name="border">
                                                <Border.BorderBrush>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#6B1A16" Offset="0" />
                                                        <GradientStop Color="#3A2740" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.BorderBrush>
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#161210" Offset="0" />
                                                        <GradientStop Color="#2B2420" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <ContentPresenter HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" x:Name="content" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <RadioButton x:Name="RadioReiko" GroupName="tema" ToolTip="Reiko"
                                 Checked="TemaSelect_Checked" Foreground="#A0917D">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource IconRadioButton}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border BorderThickness="3" CornerRadius="30" SnapsToDevicePixels="True" x:Name="border">
                                                <Border.BorderBrush>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#8FAFC7" Offset="0" />
                                                        <GradientStop Color="#A6A8B4" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.BorderBrush>
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#17191B" Offset="0" />
                                                        <GradientStop Color="#2C3033" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <ContentPresenter HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" x:Name="content" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <RadioButton x:Name="RadioTenko" GroupName="tema" ToolTip="Tenko"
                                 Checked="TemaSelect_Checked" Foreground="#A0917D">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource IconRadioButton}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border BorderThickness="3" CornerRadius="30" SnapsToDevicePixels="True" x:Name="border">
                                                <Border.BorderBrush>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#E8C468" Offset="0" />
                                                        <GradientStop Color="#A8C2D9" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.BorderBrush>
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#10141F" Offset="0" />
                                                        <GradientStop Color="#222B40" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <ContentPresenter HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" x:Name="content" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <RadioButton x:Name="RadioYako" GroupName="tema" ToolTip="Yako"
                                 Checked="TemaSelect_Checked" Foreground="#A0917D">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource IconRadioButton}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border BorderThickness="3" CornerRadius="30" SnapsToDevicePixels="True" x:Name="border">
                                                <Border.BorderBrush>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#D9702E" Offset="0" />
                                                        <GradientStop Color="#6B5878" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.BorderBrush>
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#1F1826" Offset="0" />
                                                        <GradientStop Color="#382C40" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <ContentPresenter HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" x:Name="content" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <RadioButton x:Name="RadioYoru" GroupName="tema" ToolTip="Yoru"
                                 Checked="TemaSelect_Checked" Foreground="#A0917D">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource IconRadioButton}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border BorderThickness="3" CornerRadius="30" SnapsToDevicePixels="True" x:Name="border">
                                                <Border.BorderBrush>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#D9502E" Offset="0" />
                                                        <GradientStop Color="#3A4A73" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.BorderBrush>
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#0A0C11" Offset="0" />
                                                        <GradientStop Color="#1E2430" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <ContentPresenter HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" x:Name="content" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>

                    <RadioButton x:Name="RadioZenko" GroupName="tema" ToolTip="Zenko"
                                 Checked="TemaSelect_Checked" Foreground="#A0917D">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource IconRadioButton}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border BorderThickness="3" CornerRadius="30" SnapsToDevicePixels="True" x:Name="border">
                                                <Border.BorderBrush>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#C99A2E" Offset="0" />
                                                        <GradientStop Color="#4A7A4E" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.BorderBrush>
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#F9F6ED" Offset="0" />
                                                        <GradientStop Color="#E7DFC9" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <ContentPresenter HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" x:Name="content" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                </StackPanel>
            </Border>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="20,0">
                <Button Padding="14" Width="auto" Height="auto"
                        FontFamily="{StaticResource FonteInter}"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        Command="{Binding AdicionarBackgroundCommand}"
                        BorderThickness="0" VerticalAlignment="Center"
                        hc:BorderElement.CornerRadius="24,4,4,24"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <iconPacks:PackIconBoxIcons Kind="SolidImagePlus" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Str_Selecionar_img}" FontSize="14" FontFamily="{StaticResource FonteInter}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="10,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RemoverBackgroundCommand}"
                        Width="auto" Height="auto" Padding="14"
                        ToolTip="{DynamicResource Str_Eliminar}"
                        HorizontalAlignment="Right" Margin="2,0"
                        BorderThickness="0"
                        Visibility="{Binding TemImage,Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        VerticalAlignment="Center" Cursor="Hand"
                        hc:BorderElement.CornerRadius="4,24,24,4">
                    <iconPacks:PackIconBoxIcons Kind="SolidTrashAlt" Foreground="{DynamicResource TextError}" Width="18" Height="18" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>