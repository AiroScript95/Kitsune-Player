<UserControl x:Class="Project_Kitsune.Views.ShellPages.ArtistasPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:Project_Kitsune.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Style="{StaticResource TransicaoEntrada}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="30,20,0,10"
                   Text="{DynamicResource Str_Artistas}"
                   FontSize="24" FontWeight="Bold"
                   FontFamily="{StaticResource FonteHiragino}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   VerticalAlignment="Center" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ItemsControl Grid.Column="0" Margin="10" ItemsSource="{Binding Artistas}"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                <i:Interaction.Behaviors>
                    <behaviors:ScrollGrupoViewBehavior ScrollToItem="{Binding GrupoParaScroll}" />
                </i:Interaction.Behaviors>

                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer Focusable="False"
                                      Template="{StaticResource MeuScrollViewer}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <vwp:VirtualizingWrapPanel ItemSize="192,232" StretchItems="True" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="180" Height="220" Margin="6" CornerRadius="16"
                                ClipToBounds="True" BorderThickness="0"
                                Style="{StaticResource BorderClip}"
                                Background="Transparent" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick"
                                              Command="{Binding DataContext.AbrirArtistaCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}" />
                            </Border.InputBindings>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Capa -->
                                <Border Grid.Row="0" Width="145" Height="145"
                                        Background="{DynamicResource SurfaceRaisedBrush}"
                                        Style="{StaticResource BorderCircularClip}"
                                        HorizontalAlignment="Center" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding Capa, Converter={StaticResource BytesParaImagemConverter}, ConverterParameter=240}"
                                               Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <iconPacks:PackIconBoxIcons Kind="RegularUser" Width="32" Height="32"
                                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                    Visibility="{Binding Capa, Converter={StaticResource NullToVisibilityConverter}}" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Nome}" ToolTip="{Binding Nome}"
                                               FontSize="14" FontWeight="DemiBold"
                                               FontFamily="{StaticResource FonteInter}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Center" />

                                    <TextBlock Text="{Binding ListaMusicas[0], FallbackValue=''}" FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               FontFamily="{StaticResource FonteInter}"
                                               HorizontalAlignment="Center" Margin="8,2,8,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Grid.Column="1" CornerRadius="8" Style="{DynamicResource BorderClip}">
                <Grid ClipToBounds="True">
                    <Grid Background="{DynamicResource SurfaceAltBrush}" Opacity="0.65"></Grid>
                    <ItemsControl ItemsSource="{Binding Alfabeto}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" Width="30">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold"
                                           FontFamily="{StaticResource FonteInter}"
                                           HorizontalAlignment="Center" Cursor="Hand" Margin="2,3">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource TextPrimaryBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="MouseLeftButtonDown">
                                            <i:InvokeCommandAction Command="{Binding DataContext.SaltarParaLetraCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                   CommandParameter="{Binding}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>