<UserControl x:Class="Project_Kitsune.Views.ShellPages.SearchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:local="clr-namespace:Project_Kitsune.Views.ShellPages"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Esconde a secção quando o Tag (Count da coleção) é 0 -->
        <Style x:Key="SecaoStyle" TargetType="StackPanel">
            <Style.Triggers>
                <Trigger Property="Tag">
                    <Trigger.Value>
                        <system:Int32>0</system:Int32>
                    </Trigger.Value>
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="MusicaResultadoTemplate">
            <Border CornerRadius="8" Style="{DynamicResource BorderClip}"
                    MouseLeftButtonUp="Music_MouseLeftButtonUp" BorderThickness="1"
                    ContextMenuOpening="ContextMenu_Opening"
                    Tag="{Binding DataContext.PlayerViewModel, RelativeSource={RelativeSource AncestorType=UserControl}}">

                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem ItemsSource="{Binding PlacementTarget.Tag.PlaylistsDisponiveis,
                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Header>
                                <Grid>
                                    <TextBlock Text="{DynamicResource Str_AdicionarAPlaylist}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <iconPacks:PackIconBoxIcons Kind="RegularListPlus" HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource TextPrimaryBrush}" Width="14" />
                                </Grid>
                            </MenuItem.Header>
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Command"
                                            Value="{Binding PlacementTarget.Tag.AdicionarAPlaylistCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Setter Property="CommandParameter">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource MusicaEPlaylistConverter}">
                                                <Binding Path="PlacementTarget.DataContext"
                                                         RelativeSource="{RelativeSource AncestorType=ContextMenu}" />
                                                <Binding />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </MenuItem.ItemContainerStyle>
                            <MenuItem.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Name}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Name}" Value="Favoritos">
                                                        <Setter Property="Text" Value="{DynamicResource Str_Favoritos}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </MenuItem.ItemTemplate>
                        </MenuItem>

                        <MenuItem Command="{Binding PlacementTarget.Tag.EditarMusicaCommand,
                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Header>
                                <Grid>
                                    <TextBlock Text="{DynamicResource Str_Editar}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <iconPacks:PackIconBoxIcons Kind="SolidPencil" HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource TextPrimaryBrush}" Width="14" />
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>

                        <MenuItem Command="{Binding PlacementTarget.Tag.PedirEliminarMusicaCommand,
                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Header>
                                <Grid>
                                    <TextBlock Text="{DynamicResource Str_Eliminar}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <iconPacks:PackIconBoxIcons Kind="SolidTrashAlt" HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource TextError}" Width="14" />
                                </Grid>
                            </MenuItem.Header>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid Opacity="0.65">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                <Binding />
                                                <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                         RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="Background" Value="{DynamicResource GradientBackground}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                    </Grid>
                    <Grid Margin="8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="60" Height="60" CornerRadius="8" ClipToBounds="True"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                Style="{StaticResource BorderClip}">
                            <Grid>
                                <Image Source="{Binding Image, Converter={StaticResource BytesParaImagemConverter}, ConverterParameter=120}"
                                       Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <iconPacks:PackIconBoxIcons Kind="RegularMusic" Width="18" Height="18"
                                                            Foreground="{DynamicResource TextMutedBrush}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Titulo}" FontSize="14" FontWeight="SemiBold"
                                       FontFamily="{StaticResource FonteInter}" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                        <Binding />
                                                        <Binding Path="DataContext.PlayerViewModel.MusicaAtual"
                                                                 RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding Artista}" FontSize="12" MaxWidth="150"
                                           FontFamily="{StaticResource FonteInter}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="•" Margin="4,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Album}" FontSize="12" MaxWidth="150"
                                           FontFamily="{StaticResource FonteInter}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="{Binding DuracaoArredondada}" FontSize="11"
                                   Margin="10,0" VerticalAlignment="Center"
                                   FontFamily="{StaticResource FonteInter}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="GrupoAlbum">
        </DataTemplate>

        <DataTemplate x:Key="ArtistaCard">
            <Border Width="180" Height="220" Margin="6" CornerRadius="16"
                    ClipToBounds="True" BorderThickness="0"
                    Style="{StaticResource BorderClip}"
                    Background="Transparent" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick"
                                  Command="{Binding DataContext.AbrirArtistaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="100*" />
                    </Grid.RowDefinitions>

                    <!-- Capa -->
                    <Border Grid.Row="0" Width="145" Height="145"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            Style="{StaticResource BorderCircularClip}"
                            HorizontalAlignment="Center" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding Capa, Converter={StaticResource BytesParaImagemConverter}, ConverterParameter=240}"
                                   Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <iconPacks:PackIconBoxIcons Kind="RegularUser" Width="32" Height="32"
                                                        Foreground="{DynamicResource TextMutedBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding Capa, Converter={StaticResource NullToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock Text="{Binding Nome}" ToolTip="{Binding Nome}"
                                   FontSize="14" FontWeight="DemiBold"
                                   FontFamily="{StaticResource FonteInter}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center" />

                        <TextBlock Text="{Binding ListaMusicas[0], FallbackValue=''}" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   FontFamily="{StaticResource FonteInter}"
                                   HorizontalAlignment="Center" Margin="8,2,8,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AlbumCard">
            <Border Height="120" Margin="6" CornerRadius="16"
                    ClipToBounds="True" BorderThickness="0"
                    Style="{StaticResource BorderClip}"
                    Background="Transparent" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick"
                                  Command="{Binding DataContext.AbrirAlbumCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>
                <Grid>
                    <Grid Background="{DynamicResource GradientBackground}" Opacity="0.85" />
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="100" Height="100" CornerRadius="8" ClipToBounds="True"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                Style="{StaticResource BorderClip}">
                            <Grid>
                                <Image Source="{Binding Capa, Converter={StaticResource BytesParaImagemConverter}, ConverterParameter=240}"
                                       Stretch="UniformToFill" />
                                <iconPacks:PackIconBoxIcons Kind="RegularMusic" Width="32" Height="32"
                                                            Foreground="{DynamicResource TextMutedBrush}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Visibility="{Binding Capa, Converter={StaticResource NullToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                        <Grid Grid.Column="1" Margin="16,0,0,0">
                            <Border Background="#00000090" CornerRadius="10" Padding="8,2" Margin="6"
                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="{Binding NumMusicas, StringFormat={}{0:D2}}"
                                           FontFamily="{StaticResource FonteInter}" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding Nome}" FontSize="16" FontWeight="DemiBold"
                                           FontFamily="{StaticResource FonteInter}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,8,40,4" />
                                <ItemsControl ItemsSource="{Binding ListaMusicas}" Margin="0,5">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                                <iconPacks:PackIconBoxIcons Kind="RegularMusicAlt" Width="12" Height="12"
                                                                            Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Margin="8,0" Text="{Binding}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PlaylistCard">
            <Border Height="120" Margin="6" CornerRadius="16"
                    ClipToBounds="True" BorderThickness="0"
                    Style="{StaticResource BorderClip}"
                    Background="Transparent" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick"
                                  Command="{Binding DataContext.AbrirPlaylistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding Playlist}" />
                </Border.InputBindings>
                <Grid>
                    <Grid Background="{DynamicResource GradientBackground}" Opacity="0.85" />
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border CornerRadius="8" Width="100" Height="100" ClipToBounds="True"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                Style="{StaticResource BorderClip}">
                            <Grid>
                                <Image Source="{Binding Capa, Converter={StaticResource BytesParaImagemConverter}, ConverterParameter=240}"
                                       Stretch="UniformToFill" />
                                <iconPacks:PackIconBoxIcons Kind="RegularListMusic" Width="32" Height="32"
                                                            Foreground="{DynamicResource TextMutedBrush}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Visibility="{Binding Capa, Converter={StaticResource NullToVisibilityConverter}}" />
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1" Margin="16,0,0,0">
                            <Border Background="#00000090" CornerRadius="10" Padding="8,2" Margin="6"
                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Playlist.NumMusicas, StringFormat={}{0:D2}}"
                                           FontFamily="{StaticResource FonteInter}" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </Border>

                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="DemiBold"
                                           FontFamily="{StaticResource FonteInter}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,8,0,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Playlist.Name}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Playlist.Name}" Value="Favoritos">
                                                    <Setter Property="Text" Value="{DynamicResource Str_Favoritos}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding ListaMusicas}" Margin="0,5">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                                <iconPacks:PackIconBoxIcons Kind="RegularMusicAlt" Width="12" Height="12"
                                                                            Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Margin="8,0" Text="{Binding}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Style="{StaticResource TransicaoEntrada}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="100*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0">
            <TextBlock Style="{StaticResource ConfigSectionTitle}" Margin="30,20,0,0"
                       FontSize="24" FontWeight="Bold"
                       FontFamily="{StaticResource FonteHiragino}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center">
                <Run Text="Resultado de" />
                <Run Text="{Binding searchString, Mode=OneWay}" />
            </TextBlock>
        </Grid>
        <ScrollViewer Grid.Row="1" Focusable="False" Template="{StaticResource MeuScrollViewer}" Padding="16" Margin="8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25*" />
                    <RowDefinition Height="25*" />
                    <RowDefinition Height="25*" />
                    <RowDefinition Height="25*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*" />
                </Grid.ColumnDefinitions>
                <!-- Músicas (lista, com scroll próprio para manter a virtualização) -->
                <StackPanel Grid.Row="0" Style="{StaticResource SecaoStyle}" Tag="{Binding ResultadosMusica.Count}">
                    <Grid>
                        <TextBlock Text="{DynamicResource Str_Musicas}" Style="{StaticResource TituloSecao}" />
                        <Button Command="{Binding VerMaisMusicasCommand}">
                            Ver Mais
                        </Button>
                    </Grid>
                    <ListBox Style="{x:Null}"
                             ItemsSource="{Binding ResultadosMusica}"
                             ItemTemplate="{StaticResource MusicaResultadoTemplate}"
                             ItemContainerStyle="{StaticResource HoverListBoxItemStyle}"
                             Margin="6,0"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.Resources>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Template" Value="{StaticResource MeuScrollViewer}" />
                            </Style>
                        </ListBox.Resources>
                    </ListBox>
                </StackPanel>

                <!-- Artistas -->
                <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource SecaoStyle}" Tag="{Binding ResultadosArtistas.Count}">
                    <TextBlock Text="{DynamicResource Str_Artistas}" Style="{StaticResource TituloSecao}" />
                    <ItemsControl ItemsSource="{Binding ResultadosArtistas}"
                                  ItemTemplate="{StaticResource ArtistaCard}"
                                  ScrollViewer.CanContentScroll="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <vwp:VirtualizingWrapPanel ItemSize="192,232" StretchItems="True" MaxHeight="600" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- Álbuns -->
                <StackPanel Grid.Row="2" Grid.Column="0" Style="{StaticResource SecaoStyle}" Tag="{Binding ResultadosAlbuns.Count}">
                    <TextBlock Text="{DynamicResource Str_Albuns}" Style="{StaticResource TituloSecao}" />
                    <ItemsControl ItemsSource="{Binding ResultadosAlbuns}"
                                  ItemTemplate="{StaticResource AlbumCard}"
                                  ScrollViewer.CanContentScroll="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <vwp:VirtualizingWrapPanel ItemSize="332,132" StretchItems="True" MaxHeight="600" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- Playlists -->
                <StackPanel Grid.Row="3" Grid.Column="0" Style="{StaticResource SecaoStyle}" Tag="{Binding ResultadosPlaylists.Count}">
                    <TextBlock Text="{DynamicResource Str_Playlists}" Style="{StaticResource TituloSecao}" />
                    <ItemsControl ItemsSource="{Binding ResultadosPlaylists}"
                                  ItemTemplate="{StaticResource PlaylistCard}"
                                  ScrollViewer.CanContentScroll="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <vwp:VirtualizingWrapPanel ItemSize="332,132" StretchItems="True" MaxHeight="600" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>