<UserControl x:Class="Project_Kitsune.Views.ShellPages.PlaylistDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:converters="clr-namespace:Project_Kitsune.Converters"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:local="clr-namespace:Project_Kitsune.Views.ShellPages"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:MusicaAtualConverter x:Key="MusicaAtualConverter" />
        <converters:BytesParaImagemConverter x:Key="BytesParaImagemConverter" />
        <converters:BytesParaThumbConverter x:Key="BytesParaThumbConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:IndiceParaNumeroConverter x:Key="IndiceParaNumeroConverter" />
        <converters:ZeroToCollapsedConverter x:Key="ZeroToCollapsedConverter" />
    </UserControl.Resources>

    <Grid Style="{StaticResource TransicaoEntrada}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- ===== CABEÇALHO: hero com blur ===== -->
        <Grid Grid.Row="0" Height="250" ClipToBounds="True">

            <!-- Camada de fundo: capa ampliada + blur + escurecimento -->
            <Grid>
                <Image Source="{Binding Capa, Converter={StaticResource BytesParaImagemConverter}}"
                       Stretch="UniformToFill"
                       Opacity="0.55">
                    <Image.Effect>
                        <BlurEffect Radius="10" />
                    </Image.Effect>
                </Image>
                <Border Background="{DynamicResource SurfaceBrush}" Opacity="0.6" />
                <!-- Gradient para garantir legibilidade do texto na base -->
            </Grid>

            <!-- Conteúdo em cima: capa nítida + info -->
            <Grid Margin="20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Command="{Binding VoltarCommand}"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderThickness="0" Width="40" Height="40"
                        hc:BorderElement.CornerRadius="50"
                        Foreground="{DynamicResource TextOnAccentBrush}"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        ToolTip="{DynamicResource Str_Voltar}">
                    <iconPacks:PackIconBoxIcons Kind="SolidUndo" Width="18" Height="18" />
                </Button>

                <Border Grid.Column="0" Width="150" Height="150" CornerRadius="14"
                        Style="{StaticResource BorderClip}"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        ClipToBounds="True"
                        VerticalAlignment="Bottom" Margin="0,0,0,0">
                    <Grid>
                        <Image Source="{Binding Capa, Converter={StaticResource BytesParaImagemConverter}}"
                               Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <iconPacks:PackIconBoxIcons Kind="RegularListMusic" Width="36" Height="36"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding Capa, Converter={StaticResource NullToVisibilityConverter}}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="20,0,0,0">
                    <TextBlock Text="{Binding NomePlaylist}"
                               FontSize="32" FontWeight="Bold"
                               FontFamily="{StaticResource FonteHiragino}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding NomePlaylist}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NomePlaylist}" Value="Favoritos">
                                        <Setter Property="Text" Value="{DynamicResource Str_Favoritos}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                        <TextBlock Text="{Binding NumMusicas, StringFormat='{}{0} músicas'}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="15" FontWeight="DemiBold" />
                        <TextBlock Text=" · " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="15" />
                        <TextBlock Text="{Binding DuracaoTotalFormatada}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="15" FontWeight="DemiBold" />
                    </StackPanel>

                    <Button Command="{Binding AbrirPainelAdicionarCommand}"
                            Padding="16,0" Height="34" HorizontalAlignment="Left"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource TextOnAccentBrush}"
                            BorderThickness="0" Cursor="Hand">
                        <TextBlock Text="{DynamicResource Str_Add_Musica}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
        <!-- ===== LISTA DE MÚSICAS ===== -->
        <ListBox x:Name="ScrollPrincipal" Grid.Row="2" Margin="24" ItemsSource="{Binding Musicas}"
                 Background="Transparent"
                 Padding="10,0"
                 AlternationCount="{Binding Musicas.Count}"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ItemContainerStyle="{StaticResource HoverListBoxItemStyle}"
                 BorderThickness="0">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Resources>
                <Style TargetType="Thumb">
                    <Setter Property="MinHeight" Value="40" />
                </Style>
            </ListBox.Resources>

            <ListBox.ItemTemplate>

                <DataTemplate>

                    <Border CornerRadius="8" MouseLeftButtonUp="StackPanel_MouseLeftButtonUp">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource MusicaAtualConverter}">
                                                <Binding />
                                                <Binding Path="DataContext.Player.MusicaAtual" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="Background" Value="#6969696c" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid Margin="8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <!-- NOVA: número -->
                                <ColumnDefinition Width="Auto" />
                                <!-- capa -->
                                <ColumnDefinition Width="100*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       FontFamily="{StaticResource FonteInter}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource IndiceParaNumeroConverter}">
                                        <Binding />
                                        <Binding Path="DataContext.Musicas" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>

                            <Border Grid.Column="1" Width="60" Height="60"
                                    CornerRadius="8"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    Style="{StaticResource BorderClip}"
                                    ClipToBounds="True">
                                <Grid ClipToBounds="True">
                                    <Image Source="{Binding Image, Converter={StaticResource BytesParaThumbConverter}}"
                                           Stretch="UniformToFill"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                    <iconPacks:PackIconBoxIcons Kind="RegularMusic"
                                                                Width="18" Height="18"
                                                                Foreground="{DynamicResource TextMutedBrush}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="left" Margin="12,0" Background="Transparent">
                                <TextBlock Text="{Binding Titulo}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           FontFamily="{StaticResource FonteInter}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,6">
                                    <TextBlock Text="{Binding Artista}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource FonteInter}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="•" Margin="4,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Album}"
                                               FontFamily="{StaticResource FonteInter}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Text="{Binding DuracaoArredondada}"
                                           FontFamily="{StaticResource FonteInter}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="3"
                                    Click="MenuMusica_Click"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <iconPacks:PackIconBoxIcons Kind="SolidDotsVerticalRounded" Width="16" Height="16" />
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Remover"
                                                  Command="{Binding PlacementTarget.Tag.RemoverMusicaCommand,
                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ===== INDICADOR: música a tocar ===== -->
        <Border Grid.Row="3"
                Height="100"
                Background="{DynamicResource SurfaceAltBrush}"
                Visibility="{Binding Player.MusicaAtual, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
            <Border.BorderBrush>
                <SolidColorBrush Color="{DynamicResource Border}" />
            </Border.BorderBrush>
            <Border.BorderThickness>
                <Thickness Top="1" />
            </Border.BorderThickness>
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Command="{Binding Player.AlternarLetrasCommand}" Grid.Column="0"
                        Background="Transparent" BorderThickness="0"
                        Width="auto" Height="auto" Margin="4">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="17">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <StackPanel  Orientation="Horizontal" Margin="10,0">
                        <Border Width="70" Height="70" CornerRadius="10" Style="{StaticResource BorderClip}"
                                Background="{DynamicResource SurfaceRaisedBrush}" ClipToBounds="True">
                            <Image Source="{Binding Player.MusicaAtual.Image, Converter={StaticResource BytesParaThumbConverter}}" HorizontalAlignment="Center" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">

                            <TextBlock Text="{Binding Player.MusicaAtual.Titulo, FallbackValue='Nenhuma música'}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       FontFamily="{StaticResource FonteInter}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       TextAlignment="Left"
                                       Margin="0,20,0,4" />
                            <TextBlock Text="{Binding Player.MusicaAtual.Artista}"
                                       FontSize="12"
                                       FontFamily="{StaticResource FonteInter}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       TextAlignment="Left"
                                       Margin="0,0,0,20" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- Controlos -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">

                    <!-- Anterior -->
                    <Button Command="{Binding Player.AnteriorCommand}"
                            Style="{StaticResource PlayerControlButton}"
                            Margin="6,0">
                        <Viewbox Width="26" Height="26">
                            <iconPacks:PackIconBoxIcons Kind="SolidSkipPrevious" />
                        </Viewbox>
                    </Button>

                    <!-- Play/Pause -->
                    <Button Command="{Binding Player.AlternarPlayPauseCommand}"
                            Style="{StaticResource PlayerPlayButton}"
                            Margin="6,0">
                        <Viewbox Width="26">
                            <iconPacks:PackIconBoxIcons>
                                <iconPacks:PackIconBoxIcons.Style>
                                    <Style TargetType="iconPacks:PackIconBoxIcons">
                                        <Setter Property="Kind" Value="SolidPlay" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Player.EstaTocando}" Value="True">
                                                <Setter Property="Kind" Value="SolidPause" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </iconPacks:PackIconBoxIcons.Style>
                            </iconPacks:PackIconBoxIcons>
                        </Viewbox>
                    </Button>

                    <!-- Próxima -->
                    <Button Command="{Binding Player.ProximaCommand}"
                            Style="{StaticResource PlayerControlButton}"
                            Margin="6,0">
                        <Viewbox Width="26" Height="26">
                            <iconPacks:PackIconBoxIcons Kind="SolidSkipNext" />
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== OVERLAY: adicionar música ===== -->
        <Border Grid.RowSpan="5"
                Background="#CC000000"
                Visibility="{Binding MostrarPainelAdicionar, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid Background="{DynamicResource GradientBackground}" Opacity="0.85" />
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="{DynamicResource Str_Add_Musica}"
                                   FontSize="18" FontWeight="Bold"
                                   FontFamily="{DynamicResource FonteInter}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Button Command="{Binding FecharPainelAdicionarCommand}"
                                Style="{StaticResource IconButtonSmall}"
                                HorizontalAlignment="Right">
                            <iconPacks:PackIconBoxIcons Kind="SolidX" Width="16" Height="16" />
                        </Button>
                    </Grid>

                    <!-- NOVO: caixa de pesquisa -->
                    <Border Grid.Row="1" Height="42" CornerRadius="10"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            Margin="0,0,0,12">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconBoxIcons Grid.Column="0" Kind="RegularSearch"
                                                        Width="16" Height="16"
                                                        Foreground="{DynamicResource TextMutedBrush}"
                                                        VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding TextoPesquisaAdicionar, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     VerticalAlignment="Center" VerticalContentAlignment="Center"
                                     FontFamily="{StaticResource FonteInter}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                                     hc:InfoElement.Placeholder="Pesquisar por título, artista ou álbum..." />
                        </Grid>
                    </Border>
                    <ListBox x:Name="ListaTodasMusicas" Grid.Row="2"
                             ItemsSource="{Binding TodasAsMusicas}"
                             SelectionMode="Multiple"
                             SelectionChanged="ListaTodasMusicas_SelectionChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="10,0,10,0"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource HoverListBoxItemStyle}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource ListSelectedBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <!-- checkbox -->
                                        <ColumnDefinition Width="Auto" />
                                        <!-- capa -->
                                        <ColumnDefinition Width="100*" />
                                        <ColumnDefinition Width="Auto" />
                                        <!-- duração -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Checkbox visual, reflete IsSelected do ListBoxItem -->
                                    <Border Grid.Column="0" Width="20" Height="20"
                                            CornerRadius="5"
                                            BorderBrush="{DynamicResource BorderStrongBrush}"
                                            Margin="0,0,14,0"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ListSelectedBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <iconPacks:PackIconBoxIcons Kind="SolidCheck" Width="12" Height="12"
                                                                    Foreground="{DynamicResource TextOnAccentBrush}"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <iconPacks:PackIconBoxIcons.Style>
                                                <Style TargetType="iconPacks:PackIconBoxIcons">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </iconPacks:PackIconBoxIcons.Style>
                                        </iconPacks:PackIconBoxIcons>
                                    </Border>

                                    <Border Grid.Column="1" Width="52" Height="52"
                                            CornerRadius="8"
                                            Background="{DynamicResource SurfaceRaisedBrush}"
                                            Style="{StaticResource BorderClip}"
                                            ClipToBounds="True">
                                        <Grid ClipToBounds="True">
                                            <Image Source="{Binding Image, Converter={StaticResource BytesParaThumbConverter}}"
                                                   Stretch="UniformToFill"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                            <iconPacks:PackIconBoxIcons Kind="RegularMusic"
                                                                        Width="16" Height="16"
                                                                        Foreground="{DynamicResource TextMutedBrush}"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="{Binding Image, Converter={StaticResource NullToVisibilityConverter}}" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0" Background="Transparent">
                                        <TextBlock Text="{Binding Titulo}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   FontFamily="{StaticResource FonteInter}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <TextBlock Text="{Binding Artista}"
                                                       FontSize="12"
                                                       MaxWidth="150"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource FonteInter}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="•" Margin="4,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding Album}"
                                                       FontFamily="{StaticResource FonteInter}"
                                                       FontSize="12"
                                                       MaxWidth="150"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Grid.Column="3" Text="{Binding DuracaoArredondada}"
                                               FontFamily="{StaticResource FonteInter}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="10,0,4,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="3" Margin="0,16,0,0">
                        <TextBlock Text="{Binding NumeroSelecionadas, StringFormat='{}{0} selecionadas'}"
                                   Visibility="{Binding NumeroSelecionadas, Converter={StaticResource ZeroToCollapsedConverter}}"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource FonteInter}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <Button Content="{DynamicResource Str_Concluir}"
                                Click="ConfirmarSelecao_Click"
                                HorizontalAlignment="Right"
                                Width="Auto" Height="Auto" FontSize="14" hc:BorderElement.CornerRadius="8" Padding="16,8"
                                FontFamily="{StaticResource FonteInter}"
                                Background="{DynamicResource SuccessBrush}"
                                Foreground="{DynamicResource TextOnAccentBrush}"
                                BorderThickness="0" Cursor="Hand" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>