<UserControl x:Class="Project_Kitsune.Views.ShellPages.PlaylistsPages"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:converters="clr-namespace:Project_Kitsune.Converters"
             xmlns:local="clr-namespace:Project_Kitsune.Views.ShellPages"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <converters:StringVazioParaVisibilidadeConverter x:Key="StringVazioParaVisibilidade" />
        <converters:NomeNaoFavoritosConverter x:Key="NomeNaoFavoritosConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:BytesParaImagemConverter x:Key="BytesParaImagemConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid Style="{StaticResource TransicaoEntrada}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== BARRA ÚNICA NO TOPO ===== -->
            <Grid Grid.Row="0" Margin="30,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{DynamicResource Str_Playlists}"
                           FontSize="24" FontWeight="Bold"
                           FontFamily="{StaticResource FonteHiragino}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />

                <Button Command="{Binding MostrarModalCommand}"
                        BorderThickness="0"
                        Cursor="Hand"
                        hc:BorderElement.CornerRadius="20"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        MinHeight="40"
                        MinWidth="200"
                        Background="{DynamicResource SurfaceAltBrush}"
                        Foreground="{DynamicResource TextSecondaryBrush}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center" Orientation="Horizontal">
                        <iconPacks:PackIconBoxIcons Kind="SolidPlus" HorizontalAlignment="Left"
                                                    VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Str_Add_Play}"
                                   FontFamily="{StaticResource FonteInter}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="12,0"
                                   FontSize="14" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ===== GRADE DE PLAYLISTS ===== -->
            <ScrollViewer Grid.Row="1" Margin="24" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Playlists}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="340" Height="140" Margin="6"
                                    CornerRadius="10"
                                    ClipToBounds="True"
                                    Style="{StaticResource BorderClip}"
                                    BorderThickness="0"
                                    MouseLeftButtonUp="TextBlock_MouseLeftButtonUp"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Cursor="Hand">
                                <Border.ContextMenu>
                                    <ContextMenu Visibility="{Binding Playlist.Name, Converter={StaticResource NomeNaoFavoritosConverter}}">

                                        <MenuItem CommandParameter="{Binding Playlist}"
                                                  Visibility="{Binding Playlist.Name, Converter={StaticResource NomeNaoFavoritosConverter}}">
                                            <MenuItem.Header>
                                                <Grid>
                                                    <TextBlock Text="{DynamicResource Str_Renomear}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                    <iconPacks:PackIconBoxIcons Kind="SolidTag" HorizontalAlignment="Right"
                                                                                VerticalAlignment="Center"
                                                                                Foreground="{DynamicResource TextPrimaryBrush}" Width="14" />
                                                </Grid>
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem CommandParameter="{Binding Playlist}"
                                                  Visibility="{Binding Playlist.Name, Converter={StaticResource NomeNaoFavoritosConverter}}">
                                            <MenuItem.Header>
                                                <Grid>
                                                    <TextBlock Text="{DynamicResource Str_Add_Musica}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                    <iconPacks:PackIconBoxIcons2 Kind="RegularMusic" HorizontalAlignment="Right"
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="{DynamicResource TextPrimaryBrush}" Width="14" />
                                                </Grid>
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <MenuItem Command="{Binding PlacementTarget.Tag.PedirExclusaoCommand,
                                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding Playlist}"
                                                  Visibility="{Binding Playlist.Name, Converter={StaticResource NomeNaoFavoritosConverter}}">
                                            <MenuItem.Header>
                                                <Grid>
                                                    <TextBlock Text="{DynamicResource Str_Eliminar}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                    <iconPacks:PackIconBoxIcons Kind="SolidTrashAlt" HorizontalAlignment="Right"
                                                                                VerticalAlignment="Center"
                                                                                Foreground="{DynamicResource TextError}" Width="14" />
                                                </Grid>
                                            </MenuItem.Header>
                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid Background="{DynamicResource GradientBackground}" Opacity="0.5" />
                                    <Grid Margin="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="60*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Capa quadrada, topo -->
                                        <Grid Grid.Column="0">
                                            <Border CornerRadius="8" Width="120"
                                                    Height="120"
                                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                                    Style="{StaticResource BorderClip}"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding Capa, Converter={StaticResource BytesParaImagemConverter}}"
                                                           Stretch="UniformToFill" />
                                                    <iconPacks:PackIconBoxIcons Kind="RegularListMusic"
                                                                                Width="32" Height="32"
                                                                                Foreground="{DynamicResource TextMutedBrush}"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"
                                                                                Visibility="{Binding Capa, Converter={StaticResource NullToVisibilityConverter}}" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <Grid Grid.Column="1" Margin="16,0,0,0">
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="6">
                                                <Border Background="#00000090" CornerRadius="10" Padding="8,2" Margin="0,0,0,0">
                                                    <TextBlock Text="{Binding Playlist.NumMusicas}" FontFamily="{StaticResource FonteJetBrains}"
                                                               FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                                </Border>
                                            </StackPanel>

                                            <!-- Nome -->
                                            <StackPanel>
                                                <TextBlock
                                                    FontSize="16" FontWeight="DemiBold"
                                                    FontFamily="{StaticResource FonteInter}"
                                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Margin="0,8,0,4">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding Playlist.Name}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Playlist.Name}" Value="Favoritos">
                                                                    <Setter Property="Text" Value="{DynamicResource Str_Favoritos}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Duas músicas de exemplo -->
                                                <StackPanel Margin="0,5">
                                                    <ItemsControl ItemsSource="{Binding ListaMusicas}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                                                    <iconPacks:PackIconBoxIcons Kind="RegularMusicAlt" Foreground="{DynamicResource TextMutedBrush}" />
                                                                    <TextBlock Margin="8,0" Text="{Binding}"
                                                                               FontSize="12" TextTrimming="CharacterEllipsis"
                                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ===== MODAL: NOVA PLAYLIST ===== -->
        <Grid Visibility="{Binding MostrarModalCriarPlaylist, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{DynamicResource GradientBackground}" Opacity="0.2">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseLeftButtonUp">
                        <i:InvokeCommandAction Command="{Binding FecharModalCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Border>
            <Border Background="{DynamicResource SurfaceAltBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource AccentAltBrush}"
                    CornerRadius="12" Padding="16"
                    MinWidth="340"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="0.85" ScaleY="0.85" />
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrarModalCriarPlaylist}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             From="0.85" To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             From="0.85" To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource Str_Add_Play}" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontFamily="{StaticResource FonteInter}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Button Command="{Binding FecharModalCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource IconButtonSmall}">
                            <iconPacks:PackIconBoxIcons Kind="SolidX" Width="14" Height="14" />
                        </Button>
                    </Grid>
                    <TextBox Text="{Binding NovaPlaylist, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBoxExtend}"
                             hc:InfoElement.Placeholder="{DynamicResource Str_Nome_Play}"
                             Height="Auto"
                             Margin="0,8"
                             hc:BorderElement.CornerRadius="8"
                             BorderThickness="0"
                             BorderBrush="{DynamicResource BorderBrush2}"
                             Background="{DynamicResource SurfaceRaisedBrush}"
                             FontFamily="{StaticResource FonteInter}"
                             FontSize="12"
                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Padding="16,12" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,60,0,0">
                        <Button Content="{DynamicResource Str_Cancelar}" Command="{Binding FecharModalCommand}" Margin="0,0,8,0" Padding="16,8"
                                Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource FonteInter}"
                                Background="{DynamicResource BackgroundBrush}" BorderThickness="0" Width="auto" Height="auto" hc:BorderElement.CornerRadius="8" />
                        <Button Content="{DynamicResource Str_Criar}" Command="{Binding CriarPlaylistCommand}" Padding="16,8" FontFamily="{StaticResource FonteInter}"
                                Style="{StaticResource ConfigActionButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <!-- ===== MODAL: CONFIRMAR EXCLUSÃO ===== -->
        <Grid Visibility="{Binding MostrarConfirmacaoExclusao, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{DynamicResource SurfaceBrush}" Opacity="0.6">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseLeftButtonUp">
                        <i:InvokeCommandAction Command="{Binding CancelarExclusaoCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Border>
            <Border Background="{DynamicResource SurfaceAltBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource AccentAltBrush}"
                    CornerRadius="12" Padding="16"
                    MinWidth="350"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="0.85" ScaleY="0.85" />
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrarConfirmacaoExclusao}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                             From="0.85" To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             From="0.85" To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Button Command="{Binding CancelarExclusaoCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource IconButtonSmall}">
                            <iconPacks:PackIconBoxIcons Kind="SolidX" Width="12" Height="12" />
                        </Button>
                    </Grid>
                    <TextBlock Text="{DynamicResource Str_ConfirmarExclusao}"
                               FontSize="14" TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Grid  Margin="0,40,0,0">
                        <Button Content="{DynamicResource Str_Cancelar}" Command="{Binding CancelarExclusaoCommand}"
                                Margin="0,0,8,0" Padding="16,8"
                                Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource FonteInter}"
                                Background="{DynamicResource BackgroundBrush}" BorderThickness="0" Width="auto" Height="auto"
                                hc:BorderElement.CornerRadius="8"  HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Button Command="{Binding ConfirmarExclusaoCommand}"
                                Content="{DynamicResource Str_Eliminar}"
                                Padding="16,8" Height="auto" Width="auto" FontFamily="{StaticResource FonteInter}"
                                Background="{DynamicResource SurfaceError}" BorderThickness="0"
                                Foreground="{DynamicResource TextOnAccentBrush}" hc:BorderElement.CornerRadius="8"
                                HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>