<UserControl x:Class="Project_Kitsune.Views.ShellPages.ConfiguracoesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:converter="clr-namespace:Project_Kitsune.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:Project_Kitsune.Views.ShellPages"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:vm="clr-namespace:Project_Kitsune.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <converter:StringParaImagemConverter x:Key="StringParaImagemConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Estilo de "card" reutilizável para cada secção de configuração -->
    </UserControl.Resources>

    <Grid Style="{StaticResource TransicaoEntrada}">
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource Str_Configuracoes}"
                   FontSize="22" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontFamily="{StaticResource FonteHiragino}"
                   VerticalAlignment="Center"
                   Margin="24,0" />

        <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="24,0,24,0"
                      VerticalScrollBarVisibility="Hidden" Padding="10">
            <StackPanel HorizontalAlignment="Stretch">
                <!-- ===== SECÇÃO: APARÊNCIA ===== -->
                <Border Style="{StaticResource ConfigCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_Aparecncia}" Style="{StaticResource ConfigSectionTitle}" />
                        <!-- Tema -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource Str_Idioma}" Margin="8,0" FontSize="14"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="{StaticResource FonteInter}" />
                            <ComboBox ItemsSource="{Binding IdiomasDisponiveis}"
                                      HorizontalAlignment="Right"
                                      SelectedValue="{Binding IdiomaSelecionado, Mode=TwoWay}"
                                      SelectedValuePath="Codigo"
                                      Width="150" Height="Auto"
                                      Padding="16,10"
                                      Background="{DynamicResource AccentBrush}"
                                      Foreground="{DynamicResource TextOnAccentBrush}"
                                      hc:BorderElement.CornerRadius="8"
                                      TextBlock.FontFamily="{StaticResource FonteInter}"
                                      TextBlock.FontSize="12"
                                      BorderBrush="{DynamicResource TextOnAccentBrush}" BorderThickness="0">

                                <!-- Visual dos itens dentro do menu suspenso -->
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Background="Transparent">
                                            <iconPacks:PackIconBoxIcons Kind="SolidTranslate" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding Nome}" VerticalAlignment="Center" Margin="10,0,0,0"  HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>

                                <!-- Visual do item selecionado no campo principal do ComboBox -->
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ClockListBoxItemStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="FontFamily" Value="{StaticResource FonteInter}" />
                                        <Setter Property="Padding" Value="16,8" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <Grid Background="Transparent">
                                                        <iconPacks:PackIconBoxIcons Kind="SolidTranslate" HorizontalAlignment="Left" />
                                                        <TextBlock Text="{Binding Nome}" VerticalAlignment="Center" Margin="8,0"  HorizontalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Str_Tema}" Margin="8,0" FontSize="14"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="{StaticResource FonteInter}" />
                            <Button Grid.Column="1" Command="{Binding IrParaTemaCommand}" Style="{StaticResource ConfigActionButton}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconBoxIcons Kind="RegularPalette"
                                                                Width="16" Height="16"
                                                                Margin="0,0,6,0"
                                                                VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Str_Personalizar}" VerticalAlignment="Center"
                                               FontFamily="{StaticResource FonteInter}" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== SECÇÃO: BIBLIOTECA ===== -->
                <Border Style="{StaticResource ConfigCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_Biblioteca}" Style="{StaticResource ConfigSectionTitle}" />

                        <!-- Pasta padrão -->
                        <Grid Margin="0,10,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                    Background="{DynamicResource SurfaceRaisedBrush}" Margin="0,0,12,0">
                                <iconPacks:PackIconBoxIcons Kind="SolidLock" Width="15" Height="15"
                                                            Foreground="{DynamicResource TextMutedBrush}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str_Pasta_Padrao}" FontSize="12" FontWeight="SemiBold"
                                           FontFamily="{StaticResource FonteInter}" Margin="0,0,0,4"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />

                                <TextBlock Text="{Binding PastaPadrao}" FontSize="14"
                                           FontFamily="{StaticResource FonteInter}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <!-- Lista de pastas adicionais -->
                        <ItemsControl ItemsSource="{Binding PastasAdicionais}" Margin="0,4,0,20">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                                Background="{DynamicResource SurfaceRaisedBrush}" Margin="0,0,12,0">
                                            <iconPacks:PackIconBoxIcons Kind="SolidFolder" Width="15" Height="15"
                                                                        Foreground="{DynamicResource TextMutedBrush}"
                                                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource FonteInter}"
                                                   FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="2"
                                                Style="{StaticResource RemoverPastaButton}"
                                                Command="{Binding DataContext.RemoverPastaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" ToolTip="{DynamicResource Str_Eliminar}">
                                            <iconPacks:PackIconBoxIcons Kind="SolidTrashAlt" Width="18" Height="18" Foreground="#eb5757" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Command="{Binding AdicionarPastaCommand}"
                                Style="{StaticResource ConfigActionButton}"
                                HorizontalAlignment="Left" Foreground="{DynamicResource TextOnAccentBrush}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconBoxIcons Kind="RegularFolderPlus" Width="14" Height="14"
                                                            Margin="0,0,6,0"
                                                            VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Str_Add_Pasta}"
                                           FontFamily="{StaticResource FonteInter}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>